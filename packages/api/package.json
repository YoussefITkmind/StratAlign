{
  "name": "@spm/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./strategy": {
      "types": "./dist/strategy.d.ts",
      "default": "./dist/strategy.js"
    },
    "./execution": {
      "types": "./dist/execution.d.ts",
      "default": "./dist/execution.js"
    },
    "./root": {
      "types": "./dist/root.d.ts",
      "default": "./dist/root.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@spm/domain-iam": "workspace:*",
    "@spm/domain-strategy": "workspace:*",
    "@spm/rules": "workspace:*",
    "@trpc/server": "^11.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "3.2.7"
  },
  "typesVersions": {
    "*": {
      "root": [
        "dist/root.d.ts"
      ],
      "strategy": [
        "dist/strategy.d.ts"
      ],
      "execution": [
        "dist/execution.d.ts"
      ]
    }
  }
}
