# Local Docker services
POSTGRES_USER=spm
POSTGRES_PASSWORD=spm_dev_password
POSTGRES_DB=spm_platform
POSTGRES_PORT=5432
REDIS_PORT=6379

# AI suggestions (optional).
#
# Leave AI_PROVIDER=disabled and the platform boots normally with the AI Suggest
# feature refusing politely. AI_API_KEY is read server-side only and must never
# be given a NEXT_PUBLIC_ prefix — that would publish it in the browser bundle.
AI_PROVIDER=disabled
# AI_API_KEY=
# AI_MODEL=claude-sonnet-5
# AI_BASE_URL=https://api.anthropic.com
# AI_TIMEOUT_MS=45000
# AI_MAX_RETRIES=2
