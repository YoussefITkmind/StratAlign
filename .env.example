# Local Docker services
POSTGRES_USER=spm
POSTGRES_PASSWORD=spm_dev_password
POSTGRES_DB=spm_platform
POSTGRES_PORT=5432
REDIS_PORT=6379

# AI suggestions (optional).
#
# Leave AI_PROVIDER=disabled and the platform boots normally with the AI Suggest
# feature refusing politely. AI_API_KEY is read server-side only and must never
# be given a NEXT_PUBLIC_ prefix — that would publish it in the browser bundle.
# AI_API_KEY is the same variable name regardless of which provider below is
# selected. AI_MODEL and AI_BASE_URL each default to the right value for
# whichever AI_PROVIDER is set, so they only need to be given here to override
# that default.
AI_PROVIDER=disabled

# --- OpenAI (current default provider when enabled) ---
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com

# --- Anthropic (still supported) ---
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=claude-sonnet-5
# AI_BASE_URL=https://api.anthropic.com

# AI_TIMEOUT_MS=45000
# AI_MAX_RETRIES=2
