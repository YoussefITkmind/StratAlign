{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "FRONTEND_URL",
    "NEXT_PUBLIC_TRPC_URL",
    "DATABASE_URL",
    "REDIS_URL",
    "LOG_LEVEL",
    "QUEUE_PREFIX",
    "WORKER_CONCURRENCY",
    "SCHEDULER_ENABLED",
    "SCHEDULER_TICK_INTERVAL_MS",
    "SCHEDULER_LOOKAHEAD_SECONDS",
    "SCHEDULER_TICK_BATCH_SIZE",
    "SCHEDULER_MAX_CATCHUP_OCCURRENCES",
    "SCHEDULER_DEFAULT_TIMEZONE",
    "EVENT_RELAY_INTERVAL_MS",
    "EVENT_RELAY_BATCH_SIZE",
    "NOTIFICATION_ENABLED",
    "NOTIFICATION_DEFAULT_LOCALE",
    "NOTIFICATION_FALLBACK_LOCALE",
    "NOTIFICATION_MAX_ATTEMPTS",
    "NOTIFICATION_SENDER_MODE",
    "EMAIL_API_URL",
    "EMAIL_API_KEY",
    "EMAIL_FROM_ADDRESS",
    "EMAIL_TIMEOUT_MS",
    "TEAMS_WEBHOOK_URL",
    "TEAMS_TIMEOUT_MS",
    "DIGEST_ENABLED",
    "DIGEST_SWEEP_INTERVAL_MS",
    "DIGEST_MAX_ITEMS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}