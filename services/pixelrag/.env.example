# PixelRAG service configuration
# Copy/export only the values required by your environment. Never commit real keys.

# Remote embedding GPU (optional). When unset, PixelRAG uses its local embedding runtime.
# EMBED_API_URL=https://your-embedding-service.example
# EMBED_API_TIMEOUT=120

# Grounded visual-language-model reader.
VLM_BASE_URL=https://api.openai.com/v1
VLM_MODEL=gpt-4.1-mini
# VLM_API_KEY=replace-with-your-provider-key

# Optional service-to-service auth. Use the same token in apps/backend.
# PIXELRAG_SERVICE_TOKEN=replace-with-a-random-service-token

# Operational limits.
PIXELRAG_INDEX_TIMEOUT=1800
PIXELRAG_SERVE_TIMEOUT=180
PIXELRAG_MANAGED_PORT=30002
