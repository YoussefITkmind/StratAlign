NEXT_PUBLIC_TRPC_URL=http://localhost:4000/trpc

# Required by Auth.js — generate with: npx auth secret
AUTH_SECRET=replace-me-with-a-real-secret

# TEMP STUB provider — points at the local mock IdP (src/app/api/mock-idp/*)
# for local dev/test until the real OIDC issuer lands. Swap all three for the
# real IdP's values then delete src/app/api/mock-idp + src/lib/mock-idp.
MOCK_IDP_BASE_URL=http://localhost:3000/api/mock-idp
OIDC_ISSUER=http://localhost:3000/api/mock-idp
OIDC_CLIENT_ID=mock-client
OIDC_CLIENT_SECRET=mock-secret