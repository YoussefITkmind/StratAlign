NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://spm:spm_dev_password@localhost:5432/spm_platform?schema=public
REDIS_URL=redis://localhost:6379

AUTH_SECRET=replace-with-the-same-secure-random-secret-as-the-frontend
AUTH_OIDC_ISSUER=http://localhost:8092/
AUTH_OIDC_CLIENT_ID=replace-with-the-oidc-client-id
AUTH_OIDC_JWKS_URI=http://localhost:8092/.well-known/jwks.json
AUTH_OIDC_ALLOW_VERIFIED_EMAIL_LINKING=false

# Event / worker configuration
QUEUE_PREFIX=spm
EVENT_RELAY_INTERVAL_MS=5000
EVENT_RELAY_BATCH_SIZE=200
WORKER_CONCURRENCY=5

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TICK_INTERVAL_MS=60000
SCHEDULER_LOOKAHEAD_SECONDS=300
SCHEDULER_TICK_BATCH_SIZE=500
SCHEDULER_MAX_CATCHUP_OCCURRENCES=50
SCHEDULER_DEFAULT_TIMEZONE=UTC

# Notifications
NOTIFICATION_ENABLED=true
NOTIFICATION_DEFAULT_LOCALE=en
NOTIFICATION_FALLBACK_LOCALE=en
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_SENDER_MODE=fake

# Email sender
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_TIMEOUT_MS=10000

# Microsoft Teams sender
TEAMS_WEBHOOK_URL=
TEAMS_TIMEOUT_MS=10000

# Digest notifications
DIGEST_ENABLED=true
DIGEST_SWEEP_INTERVAL_MS=300000
DIGEST_MAX_ITEMS=50
