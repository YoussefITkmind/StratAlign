NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://spm:spm_dev_password@localhost:5432/spm_platform?schema=public
REDIS_URL=redis://localhost:6379

LOG_LEVEL=info

# Queue infrastructure -------------------------------------------------------
# Namespaces every BullMQ key so environments can share one Redis instance.
QUEUE_PREFIX=spm
WORKER_CONCURRENCY=5

# Scheduler ------------------------------------------------------------------
SCHEDULER_ENABLED=true
# Heartbeat that sweeps for due definitions and due instance milestones.
SCHEDULER_TICK_INTERVAL_MS=60000
# How far ahead of now instances are materialised.
SCHEDULER_LOOKAHEAD_SECONDS=300
SCHEDULER_TICK_BATCH_SIZE=500
# Guards against a post-outage stampede of missed occurrences.
SCHEDULER_MAX_CATCHUP_OCCURRENCES=50
SCHEDULER_DEFAULT_TIMEZONE=UTC

# Event outbox ---------------------------------------------------------------
EVENT_RELAY_INTERVAL_MS=5000
EVENT_RELAY_BATCH_SIZE=200

# Notifications --------------------------------------------------------------
NOTIFICATION_ENABLED=true
NOTIFICATION_DEFAULT_LOCALE=en
NOTIFICATION_FALLBACK_LOCALE=en
NOTIFICATION_MAX_ATTEMPTS=5

# "fake" captures messages in-process instead of sending them. Live delivery
# must be opted into, so a misconfigured deployment cannot mail real people.
NOTIFICATION_SENDER_MODE=fake

# Required only when NOTIFICATION_SENDER_MODE=live. Any transactional email
# API accepting { from, to, subject, text } as JSON will work.
# EMAIL_API_URL=https://api.example-email-provider.com/v1/send
# EMAIL_API_KEY=replace-me
# EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_TIMEOUT_MS=10000

# Default Microsoft Teams incoming webhook. A recipient's stored address
# overrides this, which is how different recipients reach different channels.
# TEAMS_WEBHOOK_URL=https://example.webhook.office.com/webhookb2/...
TEAMS_TIMEOUT_MS=10000

# Digest ---------------------------------------------------------------------
DIGEST_ENABLED=true
DIGEST_SWEEP_INTERVAL_MS=300000
DIGEST_MAX_ITEMS=50