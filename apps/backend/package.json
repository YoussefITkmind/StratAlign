{
  "name": "@spm/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsc",
    "start": "tsx src/main.ts",
    "start:prod": "prisma migrate deploy && node dist/main.js",
    "pretest": "prisma generate",
    "test": "vitest run",
    "lint": "eslint src test --max-warnings=0",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "dev:worker": "tsx watch src/worker.ts",
    "start:worker": "tsx src/worker.ts",
    "start:worker:prod": "node dist/worker.js"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@spm/api": "workspace:*",
    "@spm/domain-iam": "workspace:*",
    "@spm/ingest": "workspace:*",
    "@spm/machines": "workspace:*",
    "@spm/rules": "workspace:*",
    "@trpc/server": "^11.18.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.3",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.7",
    "kysely": "0.29.2",
    "minio": "^8.0.7",
    "pg": "^8.22.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.3",
    "prisma": "^7.9.1",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "3.2.7"
  }
}
