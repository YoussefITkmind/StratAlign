generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "iam", "rules", "audit", "governance", "scheduling", "strategy", "registry", "performance"]
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
  @@schema("public")
}

model User {
  id                                String                    @id @default(uuid())
  email                             String                    @unique
  displayName                       String?                   @map("display_name")
  emailVerifiedAt                   DateTime?                 @map("email_verified_at")
  preferredLocale                   String                    @default("en") @map("preferred_locale")
  createdAt                         DateTime                  @default(now()) @map("created_at")
  updatedAt                         DateTime                  @updatedAt @map("updated_at")
  localCredential                   LocalCredential?
  oidcIdentities                    OidcIdentity[]
  scopeGrants                       ScopeGrant[]              @relation("ScopeGrantUser")
  grantsGiven                       ScopeGrant[]              @relation("ScopeGrantGrantor")
  mappingsCreated                   GroupRoleMapping[]        @relation("MappingCreator")
  rulesCreated                      RuleDefinition[]          @relation("RuleDefinitionCreator")
  kpiThresholdBindingsCreated       KpiThresholdRuleBinding[] @relation("KpiThresholdBindingCreator")
  notificationPreferences           NotificationPreference[]  @relation("NotificationPreferenceRecipient")
  notificationDeliveries            NotificationDelivery[]    @relation("NotificationDeliveryRecipient")
  notificationDigests               NotificationDigest[]      @relation("NotificationDigestRecipient")
  strategyNodesCreated              StrategyNode[]            @relation("StrategyNodeCreator")
  strategyOwnerAssignments          OwnerAssignment[]         @relation("StrategyOwner")
  strategyOwnerAssignmentsAssigned  OwnerAssignment[]         @relation("StrategyAssigner")
  strategyStagedChangesRequested    StagedChange[]            @relation("StrategyStagedChangeRequester")
  kpiVersionsOwned                  KpiVersion[]              @relation("KpiVersionOwner")
  kpiVersionsStewarded              KpiVersion[]              @relation("KpiVersionSteward")
  measurementsSubmitted             Measurement[]             @relation("MeasurementSubmitter")
  commentaryAuthored                Commentary[]              @relation("CommentaryAuthor")
  captureSessionsOwned              CaptureSession[]          @relation("CaptureSessionOwner")
  approvalCasesSubmitted            ApprovalCase[]            @relation("ApprovalCaseSubmitter")
  approvalCasesAssigned             ApprovalCase[]            @relation("ApprovalCaseParticipant")
  governanceEscalationsAssigned     EscalationCase[]          @relation("EscalationParticipant")
  governanceEscalationsAcknowledged EscalationCase[]          @relation("EscalationAcknowledgedBy")
  governanceDecisionsMade           DecisionLogEntry[]        @relation("DecisionLogActor")

  @@map("users")
  @@schema("iam")
}

model OidcIdentity {
  id              String    @id @default(uuid())
  issuer          String
  subject         String
  userId          String    @map("user_id")
  emailAtLink     String?   @map("email_at_link")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  groups          String[]  @default([])
  lastValidatedAt DateTime? @map("last_validated_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@index([userId])
  @@map("oidc_identities")
  @@schema("iam")
}

enum OrgScopeType {
  GROUP    @map("group")
  SECTOR   @map("sector")
  FUNCTION @map("function")

  @@schema("iam")
}

model Role {
  id          String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String             @unique
  description String
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  mappings    GroupRoleMapping[]
  scopeGrants ScopeGrant[]

  @@map("roles")
  @@schema("iam")
}

model GroupRoleMapping {
  id           String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  groupClaim   String            @map("group_claim")
  roleId       String            @map("role_id")
  orgScopeType OrgScopeType      @map("org_scope_type")
  orgScopeId   String            @map("org_scope_id")
  version      Int
  isCurrent    Boolean           @default(true) @map("is_current")
  supersedesId String?           @unique @map("supersedes_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  createdById  String            @map("created_by")
  role         Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdBy    User              @relation("MappingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  supersedes   GroupRoleMapping? @relation("MappingVersions", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy GroupRoleMapping? @relation("MappingVersions")

  @@unique([groupClaim, version])
  @@index([groupClaim, isCurrent])
  @@index([roleId])
  @@index([createdById])
  @@map("group_role_mappings")
  @@schema("iam")
}

model ScopeGrant {
  id           String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId       String       @map("user_id")
  roleId       String       @map("role_id")
  orgScopeType OrgScopeType @map("org_scope_type")
  orgScopeId   String       @map("org_scope_id")
  grantedAt    DateTime     @default(now()) @map("granted_at")
  grantedById  String       @map("granted_by")
  user         User         @relation("ScopeGrantUser", fields: [userId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy    User         @relation("ScopeGrantGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, orgScopeType, orgScopeId], map: "scope_grants_user_role_scope_key")
  @@index([userId])
  @@index([roleId])
  @@index([grantedById])
  @@map("scope_grants")
  @@schema("iam")
}

model StepUpPolicy {
  actionClass          String   @id @map("action_class")
  requiresStepUp       Boolean  @map("requires_step_up")
  maxSessionAgeSeconds Int      @map("max_session_age_seconds")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("step_up_policies")
  @@schema("iam")
}

model LocalCredential {
  userId       String   @id @map("user_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("local_credentials")
  @@schema("iam")
}

enum RuleType {
  THRESHOLD_STATUS @map("threshold_status")
  ROLLUP           @map("rollup")
  VARIANCE_ALERT   @map("variance_alert")
  RAG_AGGREGATION  @map("rag_aggregation")
  GATE_CRITERIA    @map("gate_criteria")

  @@schema("rules")
}

enum RuleDefinitionStatus {
  DRAFT      @map("draft")
  PUBLISHED  @map("published")
  SUPERSEDED @map("superseded")

  @@schema("rules")
}

model RuleDefinition {
  id           String               @id @default(uuid())
  ruleKey      String               @map("rule_key")
  ruleType     RuleType             @map("rule_type")
  name         String
  documentJson Json                 @map("document_json")
  version      Int
  status       RuleDefinitionStatus @default(DRAFT)
  isCurrent    Boolean              @default(true) @map("is_current")
  publishedAt  DateTime?            @map("published_at")
  supersedesId String?              @unique @map("supersedes_id")
  createdAt    DateTime             @default(now()) @map("created_at")
  createdById  String               @map("created_by")

  createdBy    User            @relation("RuleDefinitionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  supersedes   RuleDefinition? @relation("RuleDefinitionVersions", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy RuleDefinition? @relation("RuleDefinitionVersions")

  kpiRollupLinks         KpiHierarchyNode[]        @relation("KpiHierarchyRollupRule")
  kpiThresholdBindings   KpiThresholdRuleBinding[] @relation("KpiThresholdBindingRule")
  statusResultsEvaluated StatusResult[]            @relation("StatusResultRuleVersion")
  rollupResultsEvaluated RollupResult[]            @relation("RollupResultRuleVersion")

  @@unique([ruleKey, version])
  @@index([ruleKey, isCurrent])
  @@index([ruleType])
  @@index([status])
  @@index([publishedAt])
  @@index([createdById])
  @@map("rule_definitions")
  @@schema("rules")
}

enum DomainEventStatus {
  PENDING
  PUBLISHED
  FAILED

  @@schema("public")
}

model DomainEvent {
  id            String            @id @default(uuid())
  eventType     String            @map("event_type")
  eventVersion  Int               @default(1) @map("event_version")
  aggregateType String            @map("aggregate_type")
  aggregateId   String            @map("aggregate_id")
  payload       Json
  dedupeKey     String            @unique @map("dedupe_key")
  status        DomainEventStatus @default(PENDING)
  occurredAt    DateTime          @default(now()) @map("occurred_at")
  publishedAt   DateTime?         @map("published_at")
  attempts      Int               @default(0)
  lastError     String?           @map("last_error")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([status, occurredAt])
  @@map("domain_events")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Governance / Workflow
// ---------------------------------------------------------------------------

enum ApprovalCaseState {
  DRAFT             @map("draft")
  PENDING_APPROVAL  @map("pending_approval")
  APPROVED          @map("approved")
  REJECTED          @map("rejected")
  CHANGES_REQUESTED @map("changes_requested")

  @@schema("governance")
}

enum ApprovalDecision {
  APPROVED @map("approved")
  REJECTED @map("rejected")

  @@schema("governance")
}

/// Immutable, versioned workflow-machine configuration.
/// New versions append rows rather than mutating historical definitions.
model WorkflowDefinition {
  id             String   @id @default(uuid()) @db.Uuid
  workflowKey    String   @map("workflow_key")
  version        Int
  definitionJson Json     @map("definition_json")
  isCurrent      Boolean  @default(true) @map("is_current")
  supersedesId   String?  @unique @map("supersedes_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  supersedes    WorkflowDefinition? @relation("WorkflowDefinitionVersions", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy  WorkflowDefinition? @relation("WorkflowDefinitionVersions")
  approvalCases ApprovalCase[]

  @@unique([workflowKey, version])
  @@index([workflowKey, isCurrent])
  @@map("workflow_definitions")
  @@schema("governance")
}

/// Persistent instance of a configured XState workflow.
///
/// xstateContextSnapshot stores the complete persisted XState snapshot
/// required to recreate an actor after a process restart.
model ApprovalCase {
  id                    String            @id @default(uuid()) @db.Uuid
  workflowDefinitionId  String            @map("workflow_definition_id") @db.Uuid
  entityType            String            @map("entity_type")
  entityId              String            @map("entity_id")
  submittedBy           String            @map("submitted_by")
  approvalParticipantId String?           @map("approval_participant_id")
  approvalSlaMs         Int               @default(86400000) @map("approval_sla_ms")
  currentState          ApprovalCaseState @default(DRAFT) @map("current_state")
  xstateContextSnapshot Json              @map("xstate_context_snapshot")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  workflowDefinition  WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict)
  submitter           User               @relation("ApprovalCaseSubmitter", fields: [submittedBy], references: [id], onDelete: Restrict)
  approvalParticipant User?              @relation("ApprovalCaseParticipant", fields: [approvalParticipantId], references: [id], onDelete: Restrict)
  escalations         EscalationCase[]
  decisionLog         DecisionLogEntry?

  @@index([workflowDefinitionId])
  @@index([entityType, entityId])
  @@index([submittedBy])
  @@index([approvalParticipantId, currentState])
  @@index([currentState])
  @@map("approval_cases")
  @@schema("governance")
}

/// Escalation raised when an approval remains pending past its SLA deadline.
model EscalationCase {
  id             String    @id @default(uuid()) @db.Uuid
  caseId         String    @map("case_id") @db.Uuid
  participant    String
  deadline       DateTime
  acknowledgedAt DateTime? @map("acknowledged_at")
  acknowledgedBy String?   @map("acknowledged_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  approvalCase    ApprovalCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  participantUser User         @relation("EscalationParticipant", fields: [participant], references: [id], onDelete: Restrict)
  acknowledger    User?        @relation("EscalationAcknowledgedBy", fields: [acknowledgedBy], references: [id], onDelete: Restrict)

  @@unique([caseId, participant, deadline])
  @@index([caseId])
  @@index([participant, acknowledgedAt])
  @@index([deadline, acknowledgedAt])
  @@map("escalation_cases")
  @@schema("governance")
}

/// Immutable terminal approval/rejection record.
model DecisionLogEntry {
  id        String           @id @default(uuid()) @db.Uuid
  caseId    String           @unique @map("case_id") @db.Uuid
  decision  ApprovalDecision
  decidedBy String           @map("decided_by")
  decidedAt DateTime         @default(now()) @map("decided_at")
  rationale String?

  approvalCase ApprovalCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actor        User         @relation("DecisionLogActor", fields: [decidedBy], references: [id], onDelete: Restrict)

  @@index([decidedBy])
  @@index([decidedAt])
  @@map("decision_log_entries")
  @@schema("governance")
}

model JournalEntry {
  id             String   @id @default(uuid())
  sourceEventId  String?  @unique @map("source_event_id")
  sequenceNumber BigInt   @unique @map("sequence_number")
  eventType      String   @map("event_type")
  aggregateType  String   @map("aggregate_type")
  aggregateId    String   @map("aggregate_id")
  payload        Json
  correlationId  String?  @map("correlation_id")
  actorUserId    String?  @map("actor_user_id")
  occurredAt     DateTime @map("occurred_at")
  previousHash   String?  @map("previous_hash")
  entryHash      String   @unique @map("entry_hash")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([aggregateType, aggregateId, occurredAt])
  @@index([occurredAt])
  @@map("journal_entries")
  @@schema("audit")
}

model EntitySnapshot {
  id            String    @id @default(uuid())
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  version       Int
  snapshotData  Json      @map("snapshot_data")
  validFrom     DateTime  @map("valid_from")
  validTo       DateTime? @map("valid_to")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([aggregateType, aggregateId, version])
  @@index([aggregateType, aggregateId, validFrom, validTo])
  @@map("entity_snapshots")
  @@schema("audit")
}

// ---------------------------------------------------------------------------
// Strategy model
// ---------------------------------------------------------------------------

enum StrategyNodeType {
  CORPORATE_STRATEGY @map("corporate_strategy")
  THEME              @map("theme")
  OBJECTIVE          @map("objective")
  STRATEGIC_PLAY     @map("strategic_play")
  PORTFOLIO          @map("portfolio")
  AREA_OF_FOCUS      @map("area_of_focus")

  @@schema("strategy")
}

enum StrategyNodeState {
  DRAFT   @map("draft")
  ACTIVE  @map("active")
  RETIRED @map("retired")

  @@schema("strategy")
}

enum StrategyEdgeType {
  CONTAINS             @map("contains")
  EXECUTED_BY          @map("executed_by")
  BELONGS_TO_PORTFOLIO @map("belongs_to_portfolio")
  ALIGNS_TO            @map("aligns_to")

  @@schema("strategy")
}

enum PlanVersionStatus {
  DRAFT  @map("draft")
  ACTIVE @map("active")
  CLOSED @map("closed")

  @@schema("strategy")
}

enum StagedChangeKind {
  NODE_CREATE @map("node_create")
  NODE_UPDATE @map("node_update")
  NODE_RETIRE @map("node_retire")
  EDGE_LINK   @map("edge_link")
  EDGE_UNLINK @map("edge_unlink")

  @@schema("strategy")
}

enum StagedChangeStatus {
  PENDING   @map("pending")
  APPLIED   @map("applied")
  CANCELLED @map("cancelled")

  @@schema("strategy")
}

model PlanVersion {
  id                     String            @id @default(uuid()) @db.Uuid
  name                   String
  status                 PlanVersionStatus @default(DRAFT)
  opensAt                DateTime?         @map("opens_at")
  closesAt               DateTime?         @map("closes_at")
  sourcePlanVersionId    String?           @map("source_plan_version_id") @db.Uuid
  sourcePlanVersion      PlanVersion?      @relation("PlanVersionCarryForward", fields: [sourcePlanVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  carriedForwardVersions PlanVersion[]     @relation("PlanVersionCarryForward")
  nodes                  StrategyNode[]
  edges                  StrategyEdge[]
  stagedChanges          StagedChange[]

  performanceTargets TargetSeries[] @relation("PerformanceTargetPlan")

  @@index([status])
  @@index([sourcePlanVersionId])
  @@map("plan_versions")
  @@schema("strategy")
}

model StrategyNode {
  id                 String            @id @default(uuid()) @db.Uuid
  type               StrategyNodeType
  nameEn             String            @map("name_en")
  nameAr             String            @map("name_ar")
  planVersionId      String            @map("plan_version_id") @db.Uuid
  state              StrategyNodeState @default(DRAFT)
  createdBy          String            @map("created_by")
  createdAt          DateTime          @default(now()) @map("created_at")
  planVersion        PlanVersion       @relation(fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creator            User              @relation("StrategyNodeCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  outgoingEdges      StrategyEdge[]    @relation("StrategyEdgeFrom")
  incomingEdges      StrategyEdge[]    @relation("StrategyEdgeTo")
  ownerAssignments   OwnerAssignment[]
  registryOkrs       Okr[]             @relation("RegistryOkrObjective")
  registryAlignments Alignment[]       @relation("RegistryStrategyAlignment")

  performanceMeasurements    Measurement[]    @relation("PerformanceMeasurementScope")
  performanceTargets         TargetSeries[]   @relation("PerformanceTargetScope")
  performanceStatuses        StatusResult[]   @relation("PerformanceStatusScope")
  performanceRollups         RollupResult[]   @relation("PerformanceRollupScope")
  performanceCommentary      Commentary[]     @relation("PerformanceCommentaryScope")
  performanceCaptureSessions CaptureSession[] @relation("PerformanceCaptureScope")

  @@index([planVersionId, type])
  @@index([planVersionId, state])
  @@map("strategy_nodes")
  @@schema("strategy")
}

model StrategyEdge {
  id            String           @id @default(uuid()) @db.Uuid
  fromNodeId    String           @map("from_node_id") @db.Uuid
  toNodeId      String           @map("to_node_id") @db.Uuid
  edgeType      StrategyEdgeType @map("edge_type")
  planVersionId String           @map("plan_version_id") @db.Uuid
  fromNode      StrategyNode     @relation("StrategyEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  toNode        StrategyNode     @relation("StrategyEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  planVersion   PlanVersion      @relation(fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([fromNodeId, toNodeId, edgeType, planVersionId])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([planVersionId])
  @@map("strategy_edges")
  @@schema("strategy")
}

model RelationshipRule {
  id       String           @id @default(uuid()) @db.Uuid
  fromType StrategyNodeType @map("from_type")
  toType   StrategyNodeType @map("to_type")
  edgeType StrategyEdgeType @map("edge_type")
  minCount Int              @default(0) @map("min_count")
  maxCount Int?             @map("max_count")

  @@unique([fromType, toType, edgeType])
  @@map("relationship_rules")
  @@schema("strategy")
}

model OwnerAssignment {
  id          String       @id @default(uuid()) @db.Uuid
  nodeId      String       @map("node_id") @db.Uuid
  ownerUserId String       @map("owner_user_id")
  assignedBy  String       @map("assigned_by")
  assignedAt  DateTime     @default(now()) @map("assigned_at")
  node        StrategyNode @relation(fields: [nodeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  owner       User         @relation("StrategyOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assigner    User         @relation("StrategyAssigner", fields: [assignedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([nodeId, ownerUserId])
  @@index([ownerUserId])
  @@map("owner_assignments")
  @@schema("strategy")
}

model StagedChange {
  id             String             @id @default(uuid()) @db.Uuid
  approvalCaseId String             @map("approval_case_id") @db.Uuid
  planVersionId  String             @map("plan_version_id") @db.Uuid
  kind           StagedChangeKind
  targetId       String?            @map("target_id") @db.Uuid
  payload        Json
  status         StagedChangeStatus @default(PENDING)
  requestedBy    String             @map("requested_by")
  requestedAt    DateTime           @default(now()) @map("requested_at")
  appliedAt      DateTime?          @map("applied_at")
  planVersion    PlanVersion        @relation(fields: [planVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  requester      User               @relation("StrategyStagedChangeRequester", fields: [requestedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([approvalCaseId, status])
  @@index([planVersionId, status])
  @@map("staged_changes")
  @@schema("strategy")
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

enum PeriodType {
  MONTH
  QUARTER
  YEAR

  @@schema("scheduling")
}

enum CadenceType {
  MONTHLY
  QUARTERLY
  ADHOC

  @@schema("scheduling")
}

enum CadenceStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED

  @@schema("scheduling")
}

enum CatchUpPolicy {
  FIRE_ALL
  FIRE_LATEST_ONLY
  SKIP_MISSED

  @@schema("scheduling")
}

enum CadenceInstanceStatus {
  PENDING
  OPEN
  CLOSING
  CLOSED
  REVIEW_DUE
  COMPLETED
  SKIPPED
  FAILED

  @@schema("scheduling")
}

model PeriodCalendar {
  id                   String     @id @default(uuid())
  key                  String     @unique
  name                 String
  description          String?
  periodType           PeriodType @map("period_type")
  fiscalYearStartMonth Int        @default(1) @map("fiscal_year_start_month")
  timezone             String     @default("UTC")
  isActive             Boolean    @default(true) @map("is_active")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  cadenceDefinitions CadenceDefinition[]

  @@map("period_calendars")
  @@schema("scheduling")
}

model CadenceDefinition {
  id          String  @id @default(uuid())
  key         String
  name        String
  description String?

  subjectType String @map("subject_type")
  subjectId   String @map("subject_id")
  payload     Json   @default("{}")

  cadenceType   CadenceType @map("cadence_type")
  cadenceConfig Json        @map("cadence_config")

  periodCalendarId String?         @map("period_calendar_id")
  periodCalendar   PeriodCalendar? @relation(fields: [periodCalendarId], references: [id], onDelete: SetNull)

  timezone String    @default("UTC")
  anchorAt DateTime  @map("anchor_at")
  startsAt DateTime  @map("starts_at")
  endsAt   DateTime? @map("ends_at")

  status        CadenceStatus @default(ACTIVE)
  catchUpPolicy CatchUpPolicy @default(FIRE_LATEST_ONLY) @map("catch_up_policy")

  lookaheadSeconds Int @default(300) @map("lookahead_seconds")

  windowOpenOffsetMinutes Int @default(0) @map("window_open_offset_minutes")
  windowDurationMinutes   Int @default(1440) @map("window_duration_minutes")
  closingWarningMinutes   Int @default(60) @map("closing_warning_minutes")
  reviewDueOffsetMinutes  Int @default(0) @map("review_due_offset_minutes")

  nextOccurrenceAt   DateTime? @map("next_occurrence_at")
  lastMaterializedAt DateTime? @map("last_materialized_at")

  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  instances CadenceInstance[]

  @@unique([subjectType, subjectId, key])
  @@index([status, nextOccurrenceAt])
  @@index([periodCalendarId])
  @@map("cadence_definitions")
  @@schema("scheduling")
}

model CadenceInstance {
  id                  String            @id @default(uuid())
  cadenceDefinitionId String            @map("cadence_definition_id")
  cadenceDefinition   CadenceDefinition @relation(fields: [cadenceDefinitionId], references: [id], onDelete: Cascade)

  sequence     Int
  occurrenceAt DateTime @map("occurrence_at")

  periodKey      String?   @map("period_key")
  periodStartsAt DateTime? @map("period_starts_at")
  periodEndsAt   DateTime? @map("period_ends_at")

  windowOpensAt   DateTime @map("window_opens_at")
  windowClosingAt DateTime @map("window_closing_at")
  windowClosesAt  DateTime @map("window_closes_at")
  reviewDueAt     DateTime @map("review_due_at")

  status           CadenceInstanceStatus @default(PENDING)
  nextTransitionAt DateTime?             @map("next_transition_at")

  openedAt          DateTime? @map("opened_at")
  closingNotifiedAt DateTime? @map("closing_notified_at")
  closedAt          DateTime? @map("closed_at")
  reviewNotifiedAt  DateTime? @map("review_notified_at")

  payloadSnapshot Json    @map("payload_snapshot")
  skipReason      String? @map("skip_reason")
  attempts        Int     @default(0)
  lastError       String? @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cadenceDefinitionId, occurrenceAt])
  @@index([status, nextTransitionAt])
  @@map("cadence_instances")
  @@schema("scheduling")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationChannel {
  EMAIL
  TEAMS

  @@schema("public")
}

enum NotificationPriority {
  URGENT
  NORMAL
  LOW

  @@schema("public")
}

enum NotificationDeliveryMode {
  IMMEDIATE
  DIGEST

  @@schema("public")
}

enum NotificationDeliveryStatus {
  PENDING
  DEFERRED
  DIGESTED
  SENT
  FAILED
  SUPPRESSED

  @@schema("public")
}

enum NotificationDigestStatus {
  OPEN
  SENT
  SKIPPED
  FAILED

  @@schema("public")
}

model NotificationTemplate {
  id              String              @id @default(uuid())
  key             String
  locale          String
  channel         NotificationChannel
  subjectTemplate String              @map("subject_template")
  bodyTemplate    String              @map("body_template")
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@unique([key, locale, channel])
  @@map("notification_templates")
  @@schema("public")
}

model NotificationPreference {
  id                    String                   @id @default(uuid())
  recipientUserId       String                   @map("recipient_user_id")
  recipientUser         User                     @relation("NotificationPreferenceRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  channel               NotificationChannel
  deliveryMode          NotificationDeliveryMode @default(IMMEDIATE) @map("delivery_mode")
  digestIntervalMinutes Int                      @default(1440) @map("digest_interval_minutes")
  locale                String?
  timezone              String                   @default("UTC")
  address               String?
  mutedTemplateKeys     String[]                 @default([]) @map("muted_template_keys")
  isEnabled             Boolean                  @default(true) @map("is_enabled")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  @@unique([recipientUserId, channel])
  @@index([recipientUserId])
  @@map("notification_preferences")
  @@schema("public")
}

model NotificationDigest {
  id              String                   @id @default(uuid())
  recipientUserId String                   @map("recipient_user_id")
  recipientUser   User                     @relation("NotificationDigestRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  channel         NotificationChannel
  windowStartsAt  DateTime                 @map("window_starts_at")
  windowEndsAt    DateTime                 @map("window_ends_at")
  status          NotificationDigestStatus @default(OPEN)
  itemCount       Int                      @default(0) @map("item_count")
  sentAt          DateTime?                @map("sent_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  deliveries NotificationDelivery[]

  @@unique([recipientUserId, channel, windowStartsAt])
  @@index([status, windowEndsAt])
  @@index([recipientUserId])
  @@map("notification_digests")
  @@schema("public")
}

model NotificationDelivery {
  id               String              @id @default(uuid())
  recipientUserId  String              @map("recipient_user_id")
  recipientUser    User                @relation("NotificationDeliveryRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientAddress String?             @map("recipient_address")
  channel          NotificationChannel

  templateKey  String @map("template_key")
  templateData Json   @default("{}") @map("template_data")

  locale         String
  resolvedLocale String? @map("resolved_locale")
  subject        String?
  body           String?

  priority     NotificationPriority       @default(NORMAL)
  deliveryMode NotificationDeliveryMode   @default(IMMEDIATE) @map("delivery_mode")
  status       NotificationDeliveryStatus @default(PENDING)

  dedupeKey   String   @unique @map("dedupe_key")
  availableAt DateTime @default(now()) @map("available_at")

  isDigestSummary Boolean             @default(false) @map("is_digest_summary")
  digestId        String?             @map("digest_id")
  digest          NotificationDigest? @relation(fields: [digestId], references: [id], onDelete: SetNull)

  sourceEventId String? @map("source_event_id")

  attempts          Int       @default(0)
  maxAttempts       Int       @default(5) @map("max_attempts")
  providerMessageId String?   @map("provider_message_id")
  lastError         String?   @map("last_error")
  sentAt            DateTime? @map("sent_at")
  failedAt          DateTime? @map("failed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@index([recipientUserId, channel, status])
  @@index([digestId])
  @@map("notification_deliveries")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Registry (KPI / OKR)
//
// Ownership boundary: this schema owns KPI and OKR definitions only.
//
// Two references deliberately have no foreign key because the modules that
// would own them do not exist in this repository yet:
//
//   - `strategy_node_id` / `objective_node_id` point at the Strategy module
//     (Prompts 2.1-2.3). Validated through StrategyNodeGateway instead.
//   - Publication approval lives in the Workflow module (Prompt 1.5).
//     `approval_case_id` is recorded for traceability and checked through
//     ApprovalGateway; no approval_cases table is defined here.
//
// `rollup_method_rule_id` DOES have a foreign key: RuleDefinition exists.
// ---------------------------------------------------------------------------

enum KpiStatus {
  DRAFT   @map("draft")
  ACTIVE  @map("active")
  RETIRED @map("retired")

  @@schema("registry")
}

enum KpiPolarity {
  HIGHER_IS_BETTER @map("higher_is_better")
  LOWER_IS_BETTER  @map("lower_is_better")

  @@schema("registry")
}

enum KpiFrequency {
  MONTHLY   @map("monthly")
  QUARTERLY @map("quarterly")

  @@schema("registry")
}

enum KpiDataSourceType {
  MANUAL @map("manual")
  FEED   @map("feed")

  @@schema("registry")
}

enum KeyResultType {
  QUANTITATIVE @map("quantitative")
  MILESTONE    @map("milestone")

  @@schema("registry")
}

enum AlignmentType {
  OBJECTIVE @map("objective")
  PLAY      @map("play")
  SECTOR    @map("sector")
  PROJECT   @map("project")

  @@schema("registry")
}

/// Stable identity for a KPI across every version it ever has.
/// Carries no descriptive attributes: those live on KpiVersion so that
/// renaming or re-specifying a KPI never rewrites history.
model KpiDefinition {
  id              String    @id @default(uuid())
  activeVersionId String?   @unique @map("active_version_id")
  status          KpiStatus @default(DRAFT)
  retiredAt       DateTime? @map("retired_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  versions      KpiVersion[]       @relation("KpiDefinitionVersions")
  activeVersion KpiVersion?        @relation("KpiActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  alignments    Alignment[]
  parentLinks   KpiHierarchyNode[] @relation("KpiHierarchyParent")
  childLinks    KpiHierarchyNode[] @relation("KpiHierarchyChild")

  performanceRollupResults RollupResult[] @relation("PerformanceRollupParent")

  @@index([status])
  @@map("kpi_definitions")
  @@schema("registry")
}

/// Append-only. Rows are never updated or deleted; a database trigger
/// (see the registry migration) rejects UPDATE and DELETE outright.
model KpiVersion {
  id                   String            @id @default(uuid())
  kpiDefinitionId      String            @map("kpi_definition_id")
  version              Int
  nameEn               String            @map("name_en")
  nameAr               String            @map("name_ar")
  descriptionEn        String?           @map("description_en")
  descriptionAr        String?           @map("description_ar")
  unit                 String
  polarity             KpiPolarity
  frequency            KpiFrequency
  dataSourceType       KpiDataSourceType @map("data_source_type")
  calculationLogicText String?           @map("calculation_logic_text")
  ownerUserId          String            @map("owner_user_id")
  stewardUserId        String?           @map("steward_user_id")
  activeFrom           DateTime          @map("active_from")
  supersedesVersionId  String?           @unique @map("supersedes_version_id")
  /// Workflow case that authorised publication. No foreign key: the Workflow
  /// module (Prompt 1.5) owns approval cases and does not exist yet.
  approvalCaseId       String?           @map("approval_case_id")
  publishedAt          DateTime?         @map("published_at")
  createdAt            DateTime          @default(now()) @map("created_at")

  kpiDefinition KpiDefinition  @relation("KpiDefinitionVersions", fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  activeFor     KpiDefinition? @relation("KpiActiveVersion")
  owner         User           @relation("KpiVersionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  steward       User?          @relation("KpiVersionSteward", fields: [stewardUserId], references: [id], onDelete: Restrict)
  supersedes    KpiVersion?    @relation("KpiVersionChain", fields: [supersedesVersionId], references: [id], onDelete: Restrict)
  supersededBy  KpiVersion?    @relation("KpiVersionChain")

  performanceMeasurements Measurement[]    @relation("PerformanceMeasurementKpiVersion")
  performanceTargets      TargetSeries[]   @relation("PerformanceTargetKpiVersion")
  performanceStatuses     StatusResult[]   @relation("PerformanceStatusKpiVersion")
  performanceCommentary   Commentary[]     @relation("PerformanceCommentaryKpiVersion")
  performanceSessions     CaptureSession[] @relation("PerformanceCaptureKpiVersion")

  thresholdRuleBindings       KpiThresholdRuleBinding[] @relation("KpiThresholdBindingVersion")

  @@unique([kpiDefinitionId, version])
  @@index([kpiDefinitionId, activeFrom])
  @@index([ownerUserId])
  @@index([stewardUserId])
  @@index([approvalCaseId])
  @@map("kpi_versions")
  @@schema("registry")
}

model Okr {
  id String @id @default(uuid())

  /// Strategy node of type objective.
  objectiveNodeId String       @map("objective_node_id") @db.Uuid
  objectiveNode   StrategyNode @relation("RegistryOkrObjective", fields: [objectiveNodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  keyResults KeyResult[]

  @@index([objectiveNodeId])
  @@map("okrs")
  @@schema("registry")
}

model KeyResult {
  id    String        @id @default(uuid())
  okrId String        @map("okr_id")
  type  KeyResultType

  targetValue Decimal @map("target_value") @db.Decimal(20, 6)
  unit        String

  /// Progress tracked on the key result itself. Prompt 2.4 carries no
  /// measurement data model, so this is the definition-side latest value
  /// rather than a time series.
  currentValue      Decimal?  @map("current_value") @db.Decimal(20, 6)
  progressUpdatedAt DateTime? @map("progress_updated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  okr Okr @relation(fields: [okrId], references: [id], onDelete: Cascade)

  @@index([okrId])
  @@map("key_results")
  @@schema("registry")
}

/// Many-to-many between a KPI and the strategy nodes it measures.
model Alignment {
  id              String @id @default(uuid())
  kpiDefinitionId String @map("kpi_definition_id")

  strategyNodeId String @map("strategy_node_id") @db.Uuid

  alignmentType AlignmentType @map("alignment_type")
  createdAt     DateTime      @default(now()) @map("created_at")

  kpiDefinition KpiDefinition @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  strategyNode  StrategyNode  @relation("RegistryStrategyAlignment", fields: [strategyNodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([kpiDefinitionId, strategyNodeId, alignmentType])
  @@index([kpiDefinitionId])
  @@index([strategyNodeId])
  @@map("alignments")
  @@schema("registry")
}

/// Parent/child KPI edge carrying the rollup rule used to derive the parent.
model KpiHierarchyNode {
  id          String @id @default(uuid())
  parentKpiId String @map("parent_kpi_id")
  childKpiId  String @map("child_kpi_id")

  /// Must reference a RuleDefinition whose ruleType is ROLLUP. Enforced in
  /// KpiHierarchyService; the foreign key alone cannot express the type check.
  rollupMethodRuleId String @map("rollup_method_rule_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parentKpi        KpiDefinition  @relation("KpiHierarchyParent", fields: [parentKpiId], references: [id], onDelete: Cascade)
  childKpi         KpiDefinition  @relation("KpiHierarchyChild", fields: [childKpiId], references: [id], onDelete: Cascade)
  rollupMethodRule RuleDefinition @relation("KpiHierarchyRollupRule", fields: [rollupMethodRuleId], references: [id], onDelete: Restrict)

  @@unique([parentKpiId, childKpiId])
  @@index([childKpiId])
  @@index([rollupMethodRuleId])
  @@map("kpi_hierarchy_nodes")
  @@schema("registry")
}

/// Registry-owned, append-preserving history of threshold rule assignments.
/// Each row references an immutable KPI version and an immutable Rules-owned
/// RuleDefinition version. Exactly one row per KPI version may be current.
model KpiThresholdRuleBinding {
  id              String   @id @default(uuid())
  kpiVersionId    String   @map("kpi_version_id")
  thresholdRuleId String   @map("threshold_rule_id")
  isCurrent       Boolean  @default(true) @map("is_current")
  supersedesId    String?  @unique @map("supersedes_id")
  createdAt       DateTime @default(now()) @map("created_at")
  createdById     String   @map("created_by")

  kpiVersion    KpiVersion               @relation("KpiThresholdBindingVersion", fields: [kpiVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  thresholdRule RuleDefinition           @relation("KpiThresholdBindingRule", fields: [thresholdRuleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy     User                     @relation("KpiThresholdBindingCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersedes    KpiThresholdRuleBinding? @relation("KpiThresholdBindingHistory", fields: [supersedesId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersededBy  KpiThresholdRuleBinding? @relation("KpiThresholdBindingHistory")

  @@index([kpiVersionId, isCurrent])
  @@index([thresholdRuleId])
  @@index([createdById])
  @@map("kpi_threshold_rule_bindings")
  @@schema("registry")
}

// ---------------------------------------------------------------------------
// Performance data (Prompt 2.7)
//
// Performance references the real Registry and Strategy models:
// - kpi_version_id  -> registry.kpi_versions
// - scope_node_id   -> strategy.strategy_nodes
// - parent_kpi_id   -> registry.kpi_definitions
// - plan_version_id -> strategy.plan_versions.
// ---------------------------------------------------------------------------

enum MeasurementSource {
  MANUAL   @map("manual")
  FEED     @map("feed")
  TEMPLATE @map("template")

  @@schema("performance")
}

enum CaptureSessionState {
  DRAFT     @map("draft")
  SUBMITTED @map("submitted")
  RECALLED  @map("recalled")

  @@schema("performance")
}

/// Append-only. The application database role holds SELECT and INSERT only;
/// UPDATE and DELETE are revoked in PostgreSQL. Corrections insert a new row
/// carrying `supersedes_id`.
model Measurement {
  id            String            @id @default(uuid())
  kpiVersionId  String            @map("kpi_version_id")
  scopeNodeId   String            @map("scope_node_id") @db.Uuid
  period        String
  value         Decimal           @db.Decimal(20, 6)
  source        MeasurementSource
  locked        Boolean           @default(false)
  supersedesId  String?           @unique @map("supersedes_id")
  submittedById String            @map("submitted_by")
  /// Opaque object-storage reference. No upload workflow exists yet (2.8).
  evidenceRef   String?           @map("evidence_ref")
  createdAt     DateTime          @default(now()) @map("created_at")

  submittedBy  User         @relation("MeasurementSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  supersedes   Measurement? @relation("MeasurementSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy Measurement? @relation("MeasurementSupersession")

  kpiVersion KpiVersion   @relation("PerformanceMeasurementKpiVersion", fields: [kpiVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scopeNode  StrategyNode @relation("PerformanceMeasurementScope", fields: [scopeNodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([kpiVersionId, scopeNodeId, period, createdAt])
  @@index([kpiVersionId])
  @@index([scopeNodeId])
  @@index([period])
  @@index([createdAt])
  @@index([submittedById])
  @@map("measurements")
  @@schema("performance")
}

model TargetSeries {
  id            String   @id @default(uuid())
  kpiVersionId  String   @map("kpi_version_id")
  scopeNodeId   String   @map("scope_node_id") @db.Uuid
  period        String
  targetValue   Decimal  @map("target_value") @db.Decimal(20, 6)
  planVersionId String   @map("plan_version_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  kpiVersion  KpiVersion   @relation("PerformanceTargetKpiVersion", fields: [kpiVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scopeNode   StrategyNode @relation("PerformanceTargetScope", fields: [scopeNodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  planVersion PlanVersion  @relation("PerformanceTargetPlan", fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([kpiVersionId, scopeNodeId, period, planVersionId], map: "target_series_kpi_scope_period_plan_key")
  @@index([kpiVersionId, scopeNodeId, period])
  @@map("target_series")
  @@schema("performance")
}

/// Produced by the Rule Engine. Performance never derives a status itself.
model StatusResult {
  id              String   @id @default(uuid())
  kpiVersionId    String   @map("kpi_version_id")
  scopeNodeId     String   @map("scope_node_id") @db.Uuid
  period          String
  status          String
  computedAt      DateTime @default(now()) @map("computed_at")
  /// The `rules.rule_definitions` row that produced this status. That row *is*
  /// the immutable rule version.
  ruleVersionUsed String   @map("rule_version_used")
  /// Stable per (result, triggering event); makes worker retries a no-op.
  dedupeKey       String   @unique @map("dedupe_key")

  ruleVersion RuleDefinition @relation("StatusResultRuleVersion", fields: [ruleVersionUsed], references: [id], onDelete: Restrict)

  kpiVersion KpiVersion   @relation("PerformanceStatusKpiVersion", fields: [kpiVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scopeNode  StrategyNode @relation("PerformanceStatusScope", fields: [scopeNodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([kpiVersionId, scopeNodeId, period, computedAt])
  @@index([computedAt])
  @@index([ruleVersionUsed])
  @@map("status_results")
  @@schema("performance")
}

model RollupResult {
  id              String   @id @default(uuid())
  parentKpiId     String   @map("parent_kpi_id")
  scopeNodeId     String   @map("scope_node_id") @db.Uuid
  period          String
  aggregatedValue Decimal? @map("aggregated_value") @db.Decimal(20, 6)
  /// Mirrors `@spm/rules` `rollupMethodSchema`; the rule document is authoritative.
  method          String
  computedAt      DateTime @default(now()) @map("computed_at")
  ruleVersionUsed String   @map("rule_version_used")
  dedupeKey       String   @unique @map("dedupe_key")

  ruleVersion RuleDefinition @relation("RollupResultRuleVersion", fields: [ruleVersionUsed], references: [id], onDelete: Restrict)

  parentKpi KpiDefinition @relation("PerformanceRollupParent", fields: [parentKpiId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scopeNode StrategyNode  @relation("PerformanceRollupScope", fields: [scopeNodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([parentKpiId, scopeNodeId, period, computedAt])
  @@index([computedAt])
  @@index([ruleVersionUsed])
  @@map("rollup_results")
  @@schema("performance")
}

model Commentary {
  id           String   @id @default(uuid())
  kpiVersionId String   @map("kpi_version_id")
  scopeNodeId  String   @map("scope_node_id") @db.Uuid
  period       String
  authorId     String   @map("author_id")
  bodyEn       String?  @map("body_en")
  bodyAr       String?  @map("body_ar")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  author User @relation("CommentaryAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  kpiVersion KpiVersion   @relation("PerformanceCommentaryKpiVersion", fields: [kpiVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scopeNode  StrategyNode @relation("PerformanceCommentaryScope", fields: [scopeNodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([kpiVersionId, scopeNodeId, period, createdAt])
  @@index([authorId])
  @@map("commentary")
  @@schema("performance")
}

model CaptureSession {
  id           String              @id @default(uuid())
  kpiVersionId String              @map("kpi_version_id")
  scopeNodeId  String              @map("scope_node_id") @db.Uuid
  period       String
  state        CaptureSessionState @default(DRAFT)
  ownerId      String              @map("owner_id")

  /// Set on submit. The measurement this session produced, so a recall knows
  /// exactly which row a subsequent correction must supersede.
  submittedMeasurementId String?   @map("submitted_measurement_id")
  submittedAt            DateTime? @map("submitted_at")
  recalledAt             DateTime? @map("recalled_at")
  /// Recall cutoff. Past this instant the submission is final.
  recallDeadlineAt       DateTime? @map("recall_deadline_at")
  /// Set once a downstream consumer has taken the submission. Hard cutoff.
  consumedAt             DateTime? @map("consumed_at")
  draftValue             Decimal?  @map("draft_value") @db.Decimal(30, 10)
  draftEvidenceRef       String?   @map("draft_evidence_ref")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner User @relation("CaptureSessionOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  kpiVersion KpiVersion   @relation("PerformanceCaptureKpiVersion", fields: [kpiVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scopeNode  StrategyNode @relation("PerformanceCaptureScope", fields: [scopeNodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([kpiVersionId, scopeNodeId, period, state])
  @@index([ownerId])
  @@index([state])
  @@map("capture_sessions")
  @@schema("performance")
}
