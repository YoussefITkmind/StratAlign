generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "iam", "rules", "audit", "scheduling", "registry", "performance"]
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
  @@schema("public")
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  displayName             String?                  @map("display_name")
  emailVerifiedAt         DateTime?                @map("email_verified_at")
  preferredLocale         String                   @default("en") @map("preferred_locale")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  localCredential         LocalCredential?
  oidcIdentities          OidcIdentity[]
  scopeGrants             ScopeGrant[]             @relation("ScopeGrantUser")
  grantsGiven             ScopeGrant[]             @relation("ScopeGrantGrantor")
  mappingsCreated         GroupRoleMapping[]       @relation("MappingCreator")
  rulesCreated            RuleDefinition[]         @relation("RuleDefinitionCreator")
  notificationPreferences NotificationPreference[] @relation("NotificationPreferenceRecipient")
  notificationDeliveries  NotificationDelivery[]   @relation("NotificationDeliveryRecipient")
  notificationDigests     NotificationDigest[]     @relation("NotificationDigestRecipient")
  kpiVersionsOwned        KpiVersion[]             @relation("KpiVersionOwner")
  kpiVersionsStewarded    KpiVersion[]             @relation("KpiVersionSteward")
  measurementsSubmitted   Measurement[]            @relation("MeasurementSubmitter")
  commentaryAuthored      Commentary[]             @relation("CommentaryAuthor")
  captureSessionsOwned    CaptureSession[]         @relation("CaptureSessionOwner")
  measurements            Measurement[]
  commentaries            Commentary[]
  captureSessions         CaptureSession[]

  @@map("users")
  @@schema("iam")
}

model OidcIdentity {
  id              String    @id @default(uuid())
  issuer          String
  subject         String
  userId          String    @map("user_id")
  emailAtLink     String?   @map("email_at_link")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  groups          String[]  @default([])
  lastValidatedAt DateTime? @map("last_validated_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@index([userId])
  @@map("oidc_identities")
  @@schema("iam")
}

enum OrgScopeType {
  GROUP    @map("group")
  SECTOR   @map("sector")
  FUNCTION @map("function")

  @@schema("iam")
}

model Role {
  id          String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String             @unique
  description String
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  mappings    GroupRoleMapping[]
  scopeGrants ScopeGrant[]

  @@map("roles")
  @@schema("iam")
}

model GroupRoleMapping {
  id           String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  groupClaim   String            @map("group_claim")
  roleId       String            @map("role_id")
  orgScopeType OrgScopeType      @map("org_scope_type")
  orgScopeId   String            @map("org_scope_id")
  version      Int
  isCurrent    Boolean           @default(true) @map("is_current")
  supersedesId String?           @unique @map("supersedes_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  createdById  String            @map("created_by")
  role         Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdBy    User              @relation("MappingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  supersedes   GroupRoleMapping? @relation("MappingVersions", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy GroupRoleMapping? @relation("MappingVersions")

  @@unique([groupClaim, version])
  @@index([groupClaim, isCurrent])
  @@index([roleId])
  @@index([createdById])
  @@map("group_role_mappings")
  @@schema("iam")
}

model ScopeGrant {
  id           String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId       String       @map("user_id")
  roleId       String       @map("role_id")
  orgScopeType OrgScopeType @map("org_scope_type")
  orgScopeId   String       @map("org_scope_id")
  grantedAt    DateTime     @default(now()) @map("granted_at")
  grantedById  String       @map("granted_by")
  user         User         @relation("ScopeGrantUser", fields: [userId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy    User         @relation("ScopeGrantGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, orgScopeType, orgScopeId], map: "scope_grants_user_role_scope_key")
  @@index([userId])
  @@index([roleId])
  @@index([grantedById])
  @@map("scope_grants")
  @@schema("iam")
}

model StepUpPolicy {
  actionClass          String   @id @map("action_class")
  requiresStepUp       Boolean  @map("requires_step_up")
  maxSessionAgeSeconds Int      @map("max_session_age_seconds")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("step_up_policies")
  @@schema("iam")
}

model LocalCredential {
  userId       String   @id @map("user_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("local_credentials")
  @@schema("iam")
}

enum RuleType {
  THRESHOLD_STATUS @map("threshold_status")
  ROLLUP           @map("rollup")
  VARIANCE_ALERT   @map("variance_alert")
  RAG_AGGREGATION  @map("rag_aggregation")
  GATE_CRITERIA    @map("gate_criteria")

  @@schema("rules")
}

enum RuleDefinitionStatus {
  DRAFT      @map("draft")
  PUBLISHED  @map("published")
  SUPERSEDED @map("superseded")

  @@schema("rules")
}

model RuleDefinition {
  id           String               @id @default(uuid())
  ruleKey      String               @map("rule_key")
  ruleType     RuleType             @map("rule_type")
  name         String
  documentJson Json                 @map("document_json")
  version      Int
  status       RuleDefinitionStatus @default(DRAFT)
  isCurrent    Boolean              @default(true) @map("is_current")
  publishedAt  DateTime?            @map("published_at")
  supersedesId String?              @unique @map("supersedes_id")
  createdAt    DateTime             @default(now()) @map("created_at")
  createdById  String               @map("created_by")

  createdBy    User            @relation("RuleDefinitionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  supersedes   RuleDefinition? @relation("RuleDefinitionVersions", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy RuleDefinition? @relation("RuleDefinitionVersions")

  kpiRollupLinks KpiHierarchyNode[] @relation("KpiHierarchyRollupRule")
  statusResults  StatusResult[]     @relation("StatusResultRuleVersion")

  @@unique([ruleKey, version])
  @@index([ruleKey, isCurrent])
  @@index([ruleType])
  @@index([status])
  @@index([publishedAt])
  @@index([createdById])
  @@map("rule_definitions")
  @@schema("rules")
}

enum DomainEventStatus {
  PENDING
  PUBLISHED
  FAILED

  @@schema("public")
}

model DomainEvent {
  id            String            @id @default(uuid())
  eventType     String            @map("event_type")
  eventVersion  Int               @default(1) @map("event_version")
  aggregateType String            @map("aggregate_type")
  aggregateId   String            @map("aggregate_id")
  payload       Json
  dedupeKey     String            @unique @map("dedupe_key")
  status        DomainEventStatus @default(PENDING)
  occurredAt    DateTime          @default(now()) @map("occurred_at")
  publishedAt   DateTime?         @map("published_at")
  attempts      Int               @default(0)
  lastError     String?           @map("last_error")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([status, occurredAt])
  @@map("domain_events")
  @@schema("public")
}

model JournalEntry {
  id             String   @id @default(uuid())
  sourceEventId  String?  @unique @map("source_event_id")
  sequenceNumber BigInt   @unique @map("sequence_number")
  eventType      String   @map("event_type")
  aggregateType  String   @map("aggregate_type")
  aggregateId    String   @map("aggregate_id")
  payload        Json
  correlationId  String?  @map("correlation_id")
  actorUserId    String?  @map("actor_user_id")
  occurredAt     DateTime @map("occurred_at")
  previousHash   String?  @map("previous_hash")
  entryHash      String   @unique @map("entry_hash")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([aggregateType, aggregateId, occurredAt])
  @@index([occurredAt])
  @@map("journal_entries")
  @@schema("audit")
}

model EntitySnapshot {
  id            String    @id @default(uuid())
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  version       Int
  snapshotData  Json      @map("snapshot_data")
  validFrom     DateTime  @map("valid_from")
  validTo       DateTime? @map("valid_to")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([aggregateType, aggregateId, version])
  @@index([aggregateType, aggregateId, validFrom, validTo])
  @@map("entity_snapshots")
  @@schema("audit")
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

enum PeriodType {
  MONTH
  QUARTER
  YEAR

  @@schema("scheduling")
}

enum CadenceType {
  MONTHLY
  QUARTERLY
  ADHOC

  @@schema("scheduling")
}

enum CadenceStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED

  @@schema("scheduling")
}

enum CatchUpPolicy {
  FIRE_ALL
  FIRE_LATEST_ONLY
  SKIP_MISSED

  @@schema("scheduling")
}

enum CadenceInstanceStatus {
  PENDING
  OPEN
  CLOSING
  CLOSED
  REVIEW_DUE
  COMPLETED
  SKIPPED
  FAILED

  @@schema("scheduling")
}

model PeriodCalendar {
  id                   String     @id @default(uuid())
  key                  String     @unique
  name                 String
  description          String?
  periodType           PeriodType @map("period_type")
  fiscalYearStartMonth Int        @default(1) @map("fiscal_year_start_month")
  timezone             String     @default("UTC")
  isActive             Boolean    @default(true) @map("is_active")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  cadenceDefinitions CadenceDefinition[]

  @@map("period_calendars")
  @@schema("scheduling")
}

model CadenceDefinition {
  id          String  @id @default(uuid())
  key         String
  name        String
  description String?

  subjectType String @map("subject_type")
  subjectId   String @map("subject_id")
  payload     Json   @default("{}")

  cadenceType   CadenceType @map("cadence_type")
  cadenceConfig Json        @map("cadence_config")

  periodCalendarId String?         @map("period_calendar_id")
  periodCalendar   PeriodCalendar? @relation(fields: [periodCalendarId], references: [id], onDelete: SetNull)

  timezone String    @default("UTC")
  anchorAt DateTime  @map("anchor_at")
  startsAt DateTime  @map("starts_at")
  endsAt   DateTime? @map("ends_at")

  status        CadenceStatus @default(ACTIVE)
  catchUpPolicy CatchUpPolicy @default(FIRE_LATEST_ONLY) @map("catch_up_policy")

  lookaheadSeconds Int @default(300) @map("lookahead_seconds")

  windowOpenOffsetMinutes Int @default(0) @map("window_open_offset_minutes")
  windowDurationMinutes   Int @default(1440) @map("window_duration_minutes")
  closingWarningMinutes   Int @default(60) @map("closing_warning_minutes")
  reviewDueOffsetMinutes  Int @default(0) @map("review_due_offset_minutes")

  nextOccurrenceAt   DateTime? @map("next_occurrence_at")
  lastMaterializedAt DateTime? @map("last_materialized_at")

  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  instances CadenceInstance[]

  @@unique([subjectType, subjectId, key])
  @@index([status, nextOccurrenceAt])
  @@index([periodCalendarId])
  @@map("cadence_definitions")
  @@schema("scheduling")
}

model CadenceInstance {
  id                  String            @id @default(uuid())
  cadenceDefinitionId String            @map("cadence_definition_id")
  cadenceDefinition   CadenceDefinition @relation(fields: [cadenceDefinitionId], references: [id], onDelete: Cascade)

  sequence     Int
  occurrenceAt DateTime @map("occurrence_at")

  periodKey      String?   @map("period_key")
  periodStartsAt DateTime? @map("period_starts_at")
  periodEndsAt   DateTime? @map("period_ends_at")

  windowOpensAt   DateTime @map("window_opens_at")
  windowClosingAt DateTime @map("window_closing_at")
  windowClosesAt  DateTime @map("window_closes_at")
  reviewDueAt     DateTime @map("review_due_at")

  status           CadenceInstanceStatus @default(PENDING)
  nextTransitionAt DateTime?             @map("next_transition_at")

  openedAt          DateTime? @map("opened_at")
  closingNotifiedAt DateTime? @map("closing_notified_at")
  closedAt          DateTime? @map("closed_at")
  reviewNotifiedAt  DateTime? @map("review_notified_at")

  payloadSnapshot Json    @map("payload_snapshot")
  skipReason      String? @map("skip_reason")
  attempts        Int     @default(0)
  lastError       String? @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cadenceDefinitionId, occurrenceAt])
  @@index([status, nextTransitionAt])
  @@map("cadence_instances")
  @@schema("scheduling")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationChannel {
  EMAIL
  TEAMS

  @@schema("public")
}

enum NotificationPriority {
  URGENT
  NORMAL
  LOW

  @@schema("public")
}

enum NotificationDeliveryMode {
  IMMEDIATE
  DIGEST

  @@schema("public")
}

enum NotificationDeliveryStatus {
  PENDING
  DEFERRED
  DIGESTED
  SENT
  FAILED
  SUPPRESSED

  @@schema("public")
}

enum NotificationDigestStatus {
  OPEN
  SENT
  SKIPPED
  FAILED

  @@schema("public")
}

model NotificationTemplate {
  id              String              @id @default(uuid())
  key             String
  locale          String
  channel         NotificationChannel
  subjectTemplate String              @map("subject_template")
  bodyTemplate    String              @map("body_template")
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@unique([key, locale, channel])
  @@map("notification_templates")
  @@schema("public")
}

model NotificationPreference {
  id                    String                   @id @default(uuid())
  recipientUserId       String                   @map("recipient_user_id")
  recipientUser         User                     @relation("NotificationPreferenceRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  channel               NotificationChannel
  deliveryMode          NotificationDeliveryMode @default(IMMEDIATE) @map("delivery_mode")
  digestIntervalMinutes Int                      @default(1440) @map("digest_interval_minutes")
  locale                String?
  timezone              String                   @default("UTC")
  address               String?
  mutedTemplateKeys     String[]                 @default([]) @map("muted_template_keys")
  isEnabled             Boolean                  @default(true) @map("is_enabled")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  @@unique([recipientUserId, channel])
  @@index([recipientUserId])
  @@map("notification_preferences")
  @@schema("public")
}

model NotificationDigest {
  id              String                   @id @default(uuid())
  recipientUserId String                   @map("recipient_user_id")
  recipientUser   User                     @relation("NotificationDigestRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  channel         NotificationChannel
  windowStartsAt  DateTime                 @map("window_starts_at")
  windowEndsAt    DateTime                 @map("window_ends_at")
  status          NotificationDigestStatus @default(OPEN)
  itemCount       Int                      @default(0) @map("item_count")
  sentAt          DateTime?                @map("sent_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  deliveries NotificationDelivery[]

  @@unique([recipientUserId, channel, windowStartsAt])
  @@index([status, windowEndsAt])
  @@index([recipientUserId])
  @@map("notification_digests")
  @@schema("public")
}

model NotificationDelivery {
  id               String              @id @default(uuid())
  recipientUserId  String              @map("recipient_user_id")
  recipientUser    User                @relation("NotificationDeliveryRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientAddress String?             @map("recipient_address")
  channel          NotificationChannel

  templateKey  String @map("template_key")
  templateData Json   @default("{}") @map("template_data")

  locale         String
  resolvedLocale String? @map("resolved_locale")
  subject        String?
  body           String?

  priority     NotificationPriority       @default(NORMAL)
  deliveryMode NotificationDeliveryMode   @default(IMMEDIATE) @map("delivery_mode")
  status       NotificationDeliveryStatus @default(PENDING)

  dedupeKey   String   @unique @map("dedupe_key")
  availableAt DateTime @default(now()) @map("available_at")

  isDigestSummary Boolean             @default(false) @map("is_digest_summary")
  digestId        String?             @map("digest_id")
  digest          NotificationDigest? @relation(fields: [digestId], references: [id], onDelete: SetNull)

  sourceEventId String? @map("source_event_id")

  attempts          Int       @default(0)
  maxAttempts       Int       @default(5) @map("max_attempts")
  providerMessageId String?   @map("provider_message_id")
  lastError         String?   @map("last_error")
  sentAt            DateTime? @map("sent_at")
  failedAt          DateTime? @map("failed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@index([recipientUserId, channel, status])
  @@index([digestId])
  @@map("notification_deliveries")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Registry (KPI / OKR)
//
// Ownership boundary: this schema owns KPI and OKR definitions only.
//
// Two references deliberately have no foreign key because the modules that
// would own them do not exist in this repository yet:
//
//   - `strategy_node_id` / `objective_node_id` point at the Strategy module
//     (Prompts 2.1-2.3). Validated through StrategyNodeGateway instead.
//   - Publication approval lives in the Workflow module (Prompt 1.5).
//     `approval_case_id` is recorded for traceability and checked through
//     ApprovalGateway; no approval_cases table is defined here.
//
// `rollup_method_rule_id` DOES have a foreign key: RuleDefinition exists.
// ---------------------------------------------------------------------------

enum KpiStatus {
  DRAFT   @map("draft")
  ACTIVE  @map("active")
  RETIRED @map("retired")

  @@schema("registry")
}

enum KpiPolarity {
  HIGHER_IS_BETTER @map("higher_is_better")
  LOWER_IS_BETTER  @map("lower_is_better")

  @@schema("registry")
}

enum KpiFrequency {
  MONTHLY   @map("monthly")
  QUARTERLY @map("quarterly")

  @@schema("registry")
}

enum KpiDataSourceType {
  MANUAL @map("manual")
  FEED   @map("feed")

  @@schema("registry")
}

enum KeyResultType {
  QUANTITATIVE @map("quantitative")
  MILESTONE    @map("milestone")

  @@schema("registry")
}

enum AlignmentType {
  OBJECTIVE @map("objective")
  PLAY      @map("play")
  SECTOR    @map("sector")
  PROJECT   @map("project")

  @@schema("registry")
}

/// Stable identity for a KPI across every version it ever has.
/// Carries no descriptive attributes: those live on KpiVersion so that
/// renaming or re-specifying a KPI never rewrites history.
model KpiDefinition {
  id              String    @id @default(uuid())
  activeVersionId String?   @unique @map("active_version_id")
  status          KpiStatus @default(DRAFT)
  retiredAt       DateTime? @map("retired_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  versions      KpiVersion[]       @relation("KpiDefinitionVersions")
  activeVersion KpiVersion?        @relation("KpiActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  alignments    Alignment[]
  parentLinks   KpiHierarchyNode[] @relation("KpiHierarchyParent")
  childLinks    KpiHierarchyNode[] @relation("KpiHierarchyChild")
  rollupResults RollupResult[]     @relation("RollupResultParentKpi")

  @@index([status])
  @@map("kpi_definitions")
  @@schema("registry")
}

/// Append-only. Rows are never updated or deleted; a database trigger
/// (see the registry migration) rejects UPDATE and DELETE outright.
model KpiVersion {
  id                   String            @id @default(uuid())
  kpiDefinitionId      String            @map("kpi_definition_id")
  version              Int
  nameEn               String            @map("name_en")
  nameAr               String            @map("name_ar")
  descriptionEn        String?           @map("description_en")
  descriptionAr        String?           @map("description_ar")
  unit                 String
  polarity             KpiPolarity
  frequency            KpiFrequency
  dataSourceType       KpiDataSourceType @map("data_source_type")
  calculationLogicText String?           @map("calculation_logic_text")
  ownerUserId          String            @map("owner_user_id")
  stewardUserId        String?           @map("steward_user_id")
  activeFrom           DateTime          @map("active_from")
  supersedesVersionId  String?           @unique @map("supersedes_version_id")
  /// Workflow case that authorised publication. No foreign key: the Workflow
  /// module (Prompt 1.5) owns approval cases and does not exist yet.
  approvalCaseId       String?           @map("approval_case_id")
  publishedAt          DateTime?         @map("published_at")
  createdAt            DateTime          @default(now()) @map("created_at")

  kpiDefinition   KpiDefinition    @relation("KpiDefinitionVersions", fields: [kpiDefinitionId], references: [id], onDelete: Cascade)
  activeFor       KpiDefinition?   @relation("KpiActiveVersion")
  owner           User             @relation("KpiVersionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  steward         User?            @relation("KpiVersionSteward", fields: [stewardUserId], references: [id], onDelete: Restrict)
  supersedes      KpiVersion?      @relation("KpiVersionChain", fields: [supersedesVersionId], references: [id], onDelete: Restrict)
  supersededBy    KpiVersion?      @relation("KpiVersionChain")
  measurements    Measurement[]    @relation("MeasurementKpiVersion")
  targetSeries    TargetSeries[]   @relation("TargetSeriesKpiVersion")
  statusResults   StatusResult[]   @relation("StatusResultKpiVersion")
  commentaries    Commentary[]     @relation("CommentaryKpiVersion")
  captureSessions CaptureSession[] @relation("CaptureSessionKpiVersion")

  @@unique([kpiDefinitionId, version])
  @@index([kpiDefinitionId, activeFrom])
  @@index([ownerUserId])
  @@index([stewardUserId])
  @@index([approvalCaseId])
  @@map("kpi_versions")
  @@schema("registry")
}

model Okr {
  id String @id @default(uuid())

  /// Strategy node of type objective. No foreign key: the Strategy module
  /// (Prompts 2.1-2.3) owns strategy nodes and does not exist yet.
  objectiveNodeId String @map("objective_node_id")

  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  keyResults KeyResult[]

  @@index([objectiveNodeId])
  @@map("okrs")
  @@schema("registry")
}

model KeyResult {
  id    String        @id @default(uuid())
  okrId String        @map("okr_id")
  type  KeyResultType

  targetValue Decimal @map("target_value") @db.Decimal(20, 6)
  unit        String

  /// Progress tracked on the key result itself. Prompt 2.4 carries no
  /// measurement data model, so this is the definition-side latest value
  /// rather than a time series.
  currentValue      Decimal?  @map("current_value") @db.Decimal(20, 6)
  progressUpdatedAt DateTime? @map("progress_updated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  okr Okr @relation(fields: [okrId], references: [id], onDelete: Cascade)

  @@index([okrId])
  @@map("key_results")
  @@schema("registry")
}

/// Many-to-many between a KPI and the strategy nodes it measures.
model Alignment {
  id              String @id @default(uuid())
  kpiDefinitionId String @map("kpi_definition_id")

  /// No foreign key: see Okr.objectiveNodeId.
  strategyNodeId String @map("strategy_node_id")

  alignmentType AlignmentType @map("alignment_type")
  createdAt     DateTime      @default(now()) @map("created_at")

  kpiDefinition KpiDefinition @relation(fields: [kpiDefinitionId], references: [id], onDelete: Cascade)

  @@unique([kpiDefinitionId, strategyNodeId, alignmentType])
  @@index([kpiDefinitionId])
  @@index([strategyNodeId])
  @@map("alignments")
  @@schema("registry")
}

/// Parent/child KPI edge carrying the rollup rule used to derive the parent.
model KpiHierarchyNode {
  id          String @id @default(uuid())
  parentKpiId String @map("parent_kpi_id")
  childKpiId  String @map("child_kpi_id")

  /// Must reference a RuleDefinition whose ruleType is ROLLUP. Enforced in
  /// KpiHierarchyService; the foreign key alone cannot express the type check.
  rollupMethodRuleId String @map("rollup_method_rule_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parentKpi        KpiDefinition  @relation("KpiHierarchyParent", fields: [parentKpiId], references: [id], onDelete: Cascade)
  childKpi         KpiDefinition  @relation("KpiHierarchyChild", fields: [childKpiId], references: [id], onDelete: Cascade)
  rollupMethodRule RuleDefinition @relation("KpiHierarchyRollupRule", fields: [rollupMethodRuleId], references: [id], onDelete: Restrict)

  @@unique([parentKpiId, childKpiId])
  @@index([childKpiId])
  @@index([rollupMethodRuleId])
  @@map("kpi_hierarchy_nodes")
  @@schema("registry")
}

// ---------------------------------------------------------------------------
// Performance Data (Measurements, Targets, Status, Rollups, Commentary)
//
// Ownership boundary: this schema owns measurement data, target series,
// computed status/rollup results, commentary, and capture sessions.
//
// References:
//   - `kpi_version_id` references KpiVersion in registry schema (foreign key exists)
//   - `scope_node_id` points at the Strategy module (Prompts 2.1-2.3) - no FK yet
//   - `submitted_by` references User in iam schema (foreign key exists)
//   - `author_id` references User in iam schema (foreign key exists)
//   - `owner_id` references User in iam schema (foreign key exists)
//   - `rule_version_used` references RuleDefinition in rules schema (foreign key exists)
//   - `plan_version_id` points at the Strategy module - no FK yet
// ---------------------------------------------------------------------------

enum MeasurementSource {
  MANUAL   @map("manual")
  FEED     @map("feed")
  TEMPLATE @map("template")

  @@schema("performance")
}

enum CaptureSessionState {
  DRAFT     @map("draft")
  SUBMITTED @map("submitted")
  RECALLED  @map("recalled")

  @@schema("performance")
}

/// Immutable measurements with supersession support.
/// NEVER updated, only superseded by new records with supersedesId.
/// Database trigger revokes UPDATE/DELETE for the application role.
model Measurement {
  id           String            @id @default(uuid())
  kpiVersionId String            @map("kpi_version_id")
  scopeNodeId  String            @map("scope_node_id")
  period       String
  value        Decimal           @db.Decimal(20, 6)
  source       MeasurementSource
  locked       Boolean           @default(false)
  supersedesId String?           @unique @map("supersedes_id")
  submittedBy  String?           @map("submitted_by")
  evidenceRef  String?           @map("evidence_ref")
  createdAt    DateTime          @default(now()) @map("created_at")

  kpiVersion      KpiVersion   @relation("MeasurementKpiVersion", fields: [kpiVersionId], references: [id], onDelete: Restrict)
  submittedByUser User?        @relation("MeasurementSubmitter", fields: [submittedBy], references: [id], onDelete: SetNull)
  supersedes      Measurement? @relation("MeasurementSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy    Measurement? @relation("MeasurementSupersession")
  user            User?        @relation(fields: [userId], references: [id])
  userId          String?

  @@unique([kpiVersionId, scopeNodeId, period, supersedesId], name: "measurement_unique_per_period")
  @@index([kpiVersionId, scopeNodeId, period])
  @@index([supersedesId])
  @@index([submittedBy])
  @@map("measurements")
  @@schema("performance")
}

/// Target series supporting plan-vs-revised targets per FR-B12.
model TargetSeries {
  id            String   @id @default(uuid())
  kpiVersionId  String   @map("kpi_version_id")
  scopeNodeId   String   @map("scope_node_id")
  period        String
  targetValue   Decimal  @map("target_value") @db.Decimal(20, 6)
  planVersionId String?  @map("plan_version_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  kpiVersion KpiVersion @relation("TargetSeriesKpiVersion", fields: [kpiVersionId], references: [id], onDelete: Cascade)

  @@unique([kpiVersionId, scopeNodeId, period, planVersionId])
  @@index([kpiVersionId, scopeNodeId, period])
  @@map("target_series")
  @@schema("performance")
}

/// Computed status results from rule evaluation.
model StatusResult {
  id              String   @id @default(uuid())
  kpiVersionId    String   @map("kpi_version_id")
  scopeNodeId     String   @map("scope_node_id")
  period          String
  status          String
  computedAt      DateTime @map("computed_at")
  ruleVersionUsed String   @map("rule_version_used")
  createdAt       DateTime @default(now()) @map("created_at")

  kpiVersion  KpiVersion     @relation("StatusResultKpiVersion", fields: [kpiVersionId], references: [id], onDelete: Cascade)
  ruleVersion RuleDefinition @relation("StatusResultRuleVersion", fields: [ruleVersionUsed], references: [id], onDelete: Restrict)

  @@unique([kpiVersionId, scopeNodeId, period])
  @@index([kpiVersionId, scopeNodeId, period])
  @@index([ruleVersionUsed])
  @@map("status_results")
  @@schema("performance")
}

/// Computed rollup results for hierarchy parents.
model RollupResult {
  id              String   @id @default(uuid())
  parentKpiId     String   @map("parent_kpi_id")
  scopeNodeId     String   @map("scope_node_id")
  period          String
  aggregatedValue Decimal  @map("aggregated_value") @db.Decimal(20, 6)
  method          String
  createdAt       DateTime @default(now()) @map("created_at")

  parentKpi KpiDefinition @relation("RollupResultParentKpi", fields: [parentKpiId], references: [id], onDelete: Cascade)

  @@unique([parentKpiId, scopeNodeId, period])
  @@index([parentKpiId, scopeNodeId, period])
  @@map("rollup_results")
  @@schema("performance")
}

/// Bilingual commentary on measurements.
model Commentary {
  id           String   @id @default(uuid())
  kpiVersionId String   @map("kpi_version_id")
  scopeNodeId  String   @map("scope_node_id")
  period       String
  authorId     String   @map("author_id")
  bodyEn       String?  @map("body_en")
  bodyAr       String?  @map("body_ar")
  createdAt    DateTime @default(now()) @map("created_at")

  kpiVersion KpiVersion @relation("CommentaryKpiVersion", fields: [kpiVersionId], references: [id], onDelete: Cascade)
  author     User       @relation("CommentaryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id])
  userId     String?

  @@index([kpiVersionId, scopeNodeId, period])
  @@index([authorId])
  @@map("commentary")
  @@schema("performance")
}

/// Capture session for draft/submitted/recalled workflow.
model CaptureSession {
  id           String              @id @default(uuid())
  kpiVersionId String              @map("kpi_version_id")
  scopeNodeId  String              @map("scope_node_id")
  period       String
  state        CaptureSessionState
  ownerId      String              @map("owner_id")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  kpiVersion KpiVersion @relation("CaptureSessionKpiVersion", fields: [kpiVersionId], references: [id], onDelete: Cascade)
  owner      User       @relation("CaptureSessionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id])
  userId     String?

  @@unique([kpiVersionId, scopeNodeId, period])
  @@index([ownerId])
  @@map("capture_sessions")
  @@schema("performance")
}
