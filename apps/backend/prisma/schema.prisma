generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "iam", "rules", "audit", "governance", "scheduling", "strategy", "strategy_hierarchy", "registry", "performance", "scorecard", "execution", "value"]
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
  @@schema("public")
}

model User {
  id                                String                    @id @default(uuid())
  email                             String                    @unique
  displayName                       String?                   @map("display_name")
  emailVerifiedAt                   DateTime?                 @map("email_verified_at")
  preferredLocale                   String                    @default("en") @map("preferred_locale")
  createdAt                         DateTime                  @default(now()) @map("created_at")
  updatedAt                         DateTime                  @updatedAt @map("updated_at")
  localCredential                   LocalCredential?
  oidcIdentities                    OidcIdentity[]
  scopeGrants                       ScopeGrant[]              @relation("ScopeGrantUser")
  grantsGiven                       ScopeGrant[]              @relation("ScopeGrantGrantor")
  mappingsCreated                   GroupRoleMapping[]        @relation("MappingCreator")
  rulesCreated                      RuleDefinition[]          @relation("RuleDefinitionCreator")
  kpiThresholdBindingsCreated       KpiThresholdRuleBinding[] @relation("KpiThresholdBindingCreator")
  notificationPreferences           NotificationPreference[]  @relation("NotificationPreferenceRecipient")
  notificationDeliveries            NotificationDelivery[]    @relation("NotificationDeliveryRecipient")
  notificationDigests               NotificationDigest[]      @relation("NotificationDigestRecipient")
  strategyNodesCreated              StrategyNode[]            @relation("StrategyNodeCreator")
  strategyHierarchyNodesCreated     StrategyHierarchyNode[]   @relation("StrategyHierarchyNodeCreator")
  strategyOwnerAssignments          OwnerAssignment[]         @relation("StrategyOwner")
  strategyOwnerAssignmentsAssigned  OwnerAssignment[]         @relation("StrategyAssigner")
  strategyStagedChangesRequested    StagedChange[]            @relation("StrategyStagedChangeRequester")
  kpiVersionsOwned                  KpiVersion[]              @relation("KpiVersionOwner")
  kpiVersionsStewarded              KpiVersion[]              @relation("KpiVersionSteward")
  measurementsSubmitted             Measurement[]             @relation("MeasurementSubmitter")
  commentaryAuthored                Commentary[]              @relation("CommentaryAuthor")
  captureSessionsOwned              CaptureSession[]          @relation("CaptureSessionOwner")
  approvalCasesSubmitted            ApprovalCase[]            @relation("ApprovalCaseSubmitter")
  approvalCasesAssigned             ApprovalCase[]            @relation("ApprovalCaseParticipant")
  governanceEscalationsAssigned     EscalationCase[]          @relation("EscalationParticipant")
  governanceEscalationsAcknowledged EscalationCase[]          @relation("EscalationAcknowledgedBy")
  governanceDecisionsMade           DecisionLogEntry[]        @relation("DecisionLogActor")
  aiSuggestionsAccepted             AiSuggestionProvenance[]  @relation("AiSuggestionAcceptor")

  @@map("users")
  @@schema("iam")
}

model OidcIdentity {
  id              String    @id @default(uuid())
  issuer          String
  subject         String
  userId          String    @map("user_id")
  emailAtLink     String?   @map("email_at_link")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  groups          String[]  @default([])
  lastValidatedAt DateTime? @map("last_validated_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@index([userId])
  @@map("oidc_identities")
  @@schema("iam")
}

enum OrgScopeType {
  GROUP    @map("group")
  SECTOR   @map("sector")
  FUNCTION @map("function")

  @@schema("iam")
}

model Role {
  id          String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String             @unique
  description String
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  mappings    GroupRoleMapping[]
  scopeGrants ScopeGrant[]

  @@map("roles")
  @@schema("iam")
}

model GroupRoleMapping {
  id           String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  groupClaim   String            @map("group_claim")
  roleId       String            @map("role_id")
  orgScopeType OrgScopeType      @map("org_scope_type")
  orgScopeId   String            @map("org_scope_id")
  version      Int
  isCurrent    Boolean           @default(true) @map("is_current")
  supersedesId String?           @unique @map("supersedes_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  createdById  String            @map("created_by")
  role         Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdBy    User              @relation("MappingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  supersedes   GroupRoleMapping? @relation("MappingVersions", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy GroupRoleMapping? @relation("MappingVersions")

  @@unique([groupClaim, version])
  @@index([groupClaim, isCurrent])
  @@index([roleId])
  @@index([createdById])
  @@map("group_role_mappings")
  @@schema("iam")
}

model ScopeGrant {
  id           String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId       String       @map("user_id")
  roleId       String       @map("role_id")
  orgScopeType OrgScopeType @map("org_scope_type")
  orgScopeId   String       @map("org_scope_id")
  grantedAt    DateTime     @default(now()) @map("granted_at")
  grantedById  String       @map("granted_by")
  user         User         @relation("ScopeGrantUser", fields: [userId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy    User         @relation("ScopeGrantGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, orgScopeType, orgScopeId], map: "scope_grants_user_role_scope_key")
  @@index([userId])
  @@index([roleId])
  @@index([grantedById])
  @@map("scope_grants")
  @@schema("iam")
}

model StepUpPolicy {
  actionClass          String   @id @map("action_class")
  requiresStepUp       Boolean  @map("requires_step_up")
  maxSessionAgeSeconds Int      @map("max_session_age_seconds")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("step_up_policies")
  @@schema("iam")
}

model LocalCredential {
  userId       String   @id @map("user_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("local_credentials")
  @@schema("iam")
}

enum RuleType {
  THRESHOLD_STATUS @map("threshold_status")
  ROLLUP           @map("rollup")
  VARIANCE_ALERT   @map("variance_alert")
  RAG_AGGREGATION  @map("rag_aggregation")
  GATE_CRITERIA    @map("gate_criteria")

  @@schema("rules")
}

enum RuleDefinitionStatus {
  DRAFT      @map("draft")
  PUBLISHED  @map("published")
  SUPERSEDED @map("superseded")

  @@schema("rules")
}

model RuleDefinition {
  id           String               @id @default(uuid())
  ruleKey      String               @map("rule_key")
  ruleType     RuleType             @map("rule_type")
  name         String
  documentJson Json                 @map("document_json")
  version      Int
  status       RuleDefinitionStatus @default(DRAFT)
  isCurrent    Boolean              @default(true) @map("is_current")
  publishedAt  DateTime?            @map("published_at")
  supersedesId String?              @unique @map("supersedes_id")
  createdAt    DateTime             @default(now()) @map("created_at")
  createdById  String               @map("created_by")

  createdBy    User            @relation("RuleDefinitionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  supersedes   RuleDefinition? @relation("RuleDefinitionVersions", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy RuleDefinition? @relation("RuleDefinitionVersions")

  kpiRollupLinks         KpiHierarchyNode[]        @relation("KpiHierarchyRollupRule")
  kpiThresholdBindings   KpiThresholdRuleBinding[] @relation("KpiThresholdBindingRule")
  statusResultsEvaluated StatusResult[]            @relation("StatusResultRuleVersion")
  rollupResultsEvaluated RollupResult[]            @relation("RollupResultRuleVersion")

  @@unique([ruleKey, version])
  @@index([ruleKey, isCurrent])
  @@index([ruleType])
  @@index([status])
  @@index([publishedAt])
  @@index([createdById])
  @@map("rule_definitions")
  @@schema("rules")
}

enum DomainEventStatus {
  PENDING
  PUBLISHED
  FAILED

  @@schema("public")
}

model DomainEvent {
  id            String            @id @default(uuid())
  eventType     String            @map("event_type")
  eventVersion  Int               @default(1) @map("event_version")
  aggregateType String            @map("aggregate_type")
  aggregateId   String            @map("aggregate_id")
  payload       Json
  dedupeKey     String            @unique @map("dedupe_key")
  status        DomainEventStatus @default(PENDING)
  occurredAt    DateTime          @default(now()) @map("occurred_at")
  publishedAt   DateTime?         @map("published_at")
  attempts      Int               @default(0)
  lastError     String?           @map("last_error")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([status, occurredAt])
  @@map("domain_events")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Governance / Workflow
// ---------------------------------------------------------------------------

enum ApprovalCaseState {
  DRAFT             @map("draft")
  PENDING_APPROVAL  @map("pending_approval")
  APPROVED          @map("approved")
  REJECTED          @map("rejected")
  CHANGES_REQUESTED @map("changes_requested")

  @@schema("governance")
}

enum ApprovalDecision {
  APPROVED @map("approved")
  REJECTED @map("rejected")
  CHANGES_REQUESTED @map("changes_requested")

  @@schema("governance")
}

/// Immutable, versioned workflow-machine configuration.
/// New versions append rows rather than mutating historical definitions.
model WorkflowDefinition {
  id             String   @id @default(uuid()) @db.Uuid
  workflowKey    String   @map("workflow_key")
  version        Int
  definitionJson Json     @map("definition_json")
  isCurrent      Boolean  @default(true) @map("is_current")
  supersedesId   String?  @unique @map("supersedes_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  supersedes    WorkflowDefinition? @relation("WorkflowDefinitionVersions", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy  WorkflowDefinition? @relation("WorkflowDefinitionVersions")
  approvalCases ApprovalCase[]

  @@unique([workflowKey, version])
  @@index([workflowKey, isCurrent])
  @@map("workflow_definitions")
  @@schema("governance")
}

/// Persistent instance of a configured XState workflow.
///
/// xstateContextSnapshot stores the complete persisted XState snapshot
/// required to recreate an actor after a process restart.
model ApprovalCase {
  id                    String            @id @default(uuid()) @db.Uuid
  workflowDefinitionId  String            @map("workflow_definition_id") @db.Uuid
  entityType            String            @map("entity_type")
  entityId              String            @map("entity_id")
  submittedBy           String            @map("submitted_by")
  approvalParticipantId String?           @map("approval_participant_id")
  approvalSlaMs         Int               @default(86400000) @map("approval_sla_ms")
  currentState          ApprovalCaseState @default(DRAFT) @map("current_state")
  xstateContextSnapshot Json              @map("xstate_context_snapshot")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  workflowDefinition  WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict)
  submitter           User               @relation("ApprovalCaseSubmitter", fields: [submittedBy], references: [id], onDelete: Restrict)
  approvalParticipant User?              @relation("ApprovalCaseParticipant", fields: [approvalParticipantId], references: [id], onDelete: Restrict)
  escalations         EscalationCase[]
  decisionLog         DecisionLogEntry[]

  @@index([workflowDefinitionId])
  @@index([entityType, entityId])
  @@index([submittedBy])
  @@index([approvalParticipantId, currentState])
  @@index([currentState])
  @@map("approval_cases")
  @@schema("governance")
}

/// Escalation raised when an approval remains pending past its SLA deadline.
model EscalationCase {
  id             String    @id @default(uuid()) @db.Uuid
  caseId         String    @map("case_id") @db.Uuid
  participant    String
  deadline       DateTime
  acknowledgedAt DateTime? @map("acknowledged_at")
  acknowledgedBy String?   @map("acknowledged_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  approvalCase    ApprovalCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  participantUser User         @relation("EscalationParticipant", fields: [participant], references: [id], onDelete: Restrict)
  acknowledger    User?        @relation("EscalationAcknowledgedBy", fields: [acknowledgedBy], references: [id], onDelete: Restrict)

  @@unique([caseId, participant, deadline])
  @@index([caseId])
  @@index([participant, acknowledgedAt])
  @@index([deadline, acknowledgedAt])
  @@map("escalation_cases")
  @@schema("governance")
}

/// Immutable decision record. One case can accumulate several entries over
/// its lifetime (e.g. changes_requested -> resubmit -> approved), so caseId
/// is not unique; each row is still write-once.
model DecisionLogEntry {
  id        String           @id @default(uuid()) @db.Uuid
  caseId    String           @map("case_id") @db.Uuid
  decision  ApprovalDecision
  decidedBy String           @map("decided_by")
  decidedAt DateTime         @default(now()) @map("decided_at")
  rationale String?

  approvalCase ApprovalCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actor        User         @relation("DecisionLogActor", fields: [decidedBy], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@index([decidedBy])
  @@index([decidedAt])
  @@map("decision_log_entries")
  @@schema("governance")
}

model JournalEntry {
  id             String   @id @default(uuid())
  sourceEventId  String?  @unique @map("source_event_id")
  sequenceNumber BigInt   @unique @map("sequence_number")
  eventType      String   @map("event_type")
  aggregateType  String   @map("aggregate_type")
  aggregateId    String   @map("aggregate_id")
  payload        Json
  correlationId  String?  @map("correlation_id")
  actorUserId    String?  @map("actor_user_id")
  occurredAt     DateTime @map("occurred_at")
  previousHash   String?  @map("previous_hash")
  entryHash      String   @unique @map("entry_hash")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([aggregateType, aggregateId, occurredAt])
  @@index([occurredAt])
  @@map("journal_entries")
  @@schema("audit")
}

model EntitySnapshot {
  id            String    @id @default(uuid())
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  version       Int
  snapshotData  Json      @map("snapshot_data")
  validFrom     DateTime  @map("valid_from")
  validTo       DateTime? @map("valid_to")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([aggregateType, aggregateId, version])
  @@index([aggregateType, aggregateId, validFrom, validTo])
  @@map("entity_snapshots")
  @@schema("audit")
}

// ---------------------------------------------------------------------------
// Strategy model
// ---------------------------------------------------------------------------

enum StrategyNodeType {
  CORPORATE_STRATEGY @map("corporate_strategy")
  THEME              @map("theme")
  OBJECTIVE          @map("objective")
  STRATEGIC_PLAY     @map("strategic_play")
  PORTFOLIO          @map("portfolio")
  AREA_OF_FOCUS      @map("area_of_focus")

  @@schema("strategy")
}

enum StrategyNodeState {
  DRAFT   @map("draft")
  ACTIVE  @map("active")
  RETIRED @map("retired")

  @@schema("strategy")
}

enum StrategyEdgeType {
  CONTAINS             @map("contains")
  EXECUTED_BY          @map("executed_by")
  BELONGS_TO_PORTFOLIO @map("belongs_to_portfolio")
  ALIGNS_TO            @map("aligns_to")

  @@schema("strategy")
}

enum PlanVersionStatus {
  DRAFT  @map("draft")
  ACTIVE @map("active")
  CLOSED @map("closed")

  @@schema("strategy")
}

enum StagedChangeKind {
  NODE_CREATE @map("node_create")
  NODE_UPDATE @map("node_update")
  NODE_RETIRE @map("node_retire")
  EDGE_LINK   @map("edge_link")
  EDGE_UNLINK @map("edge_unlink")

  @@schema("strategy")
}

enum StagedChangeStatus {
  PENDING   @map("pending")
  APPLIED   @map("applied")
  CANCELLED @map("cancelled")

  @@schema("strategy")
}

model PlanVersion {
  id                     String            @id @default(uuid()) @db.Uuid
  name                   String
  status                 PlanVersionStatus @default(DRAFT)
  opensAt                DateTime?         @map("opens_at")
  closesAt               DateTime?         @map("closes_at")
  sourcePlanVersionId    String?           @map("source_plan_version_id") @db.Uuid
  sourcePlanVersion      PlanVersion?      @relation("PlanVersionCarryForward", fields: [sourcePlanVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  carriedForwardVersions PlanVersion[]     @relation("PlanVersionCarryForward")
  nodes                  StrategyNode[]
  edges                  StrategyEdge[]
  stagedChanges          StagedChange[]

  performanceTargets TargetSeries[] @relation("PerformanceTargetPlan")

  @@index([status])
  @@index([sourcePlanVersionId])
  @@map("plan_versions")
  @@schema("strategy")
}

model StrategyNode {
  id                 String            @id @default(uuid()) @db.Uuid
  type               StrategyNodeType
  nameEn             String            @map("name_en")
  nameAr             String            @map("name_ar")
  planVersionId      String            @map("plan_version_id") @db.Uuid
  state              StrategyNodeState @default(DRAFT)
  createdBy          String            @map("created_by")
  createdAt          DateTime          @default(now()) @map("created_at")
  planVersion        PlanVersion       @relation(fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creator            User              @relation("StrategyNodeCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  outgoingEdges      StrategyEdge[]    @relation("StrategyEdgeFrom")
  incomingEdges      StrategyEdge[]    @relation("StrategyEdgeTo")
  ownerAssignments   OwnerAssignment[]
  registryOkrs       Okr[]             @relation("RegistryOkrObjective")
  registryAlignments Alignment[]       @relation("RegistryStrategyAlignment")

  aiSuggestionProvenance AiSuggestionProvenance[] @relation("AiSuggestionTheme")

  performanceMeasurements    Measurement[]    @relation("PerformanceMeasurementScope")
  performanceTargets         TargetSeries[]   @relation("PerformanceTargetScope")
  performanceStatuses        StatusResult[]   @relation("PerformanceStatusScope")
  performanceRollups         RollupResult[]   @relation("PerformanceRollupScope")
  performanceCommentary      Commentary[]     @relation("PerformanceCommentaryScope")
  performanceCaptureSessions CaptureSession[] @relation("PerformanceCaptureScope")

  @@index([planVersionId, type])
  @@index([planVersionId, state])
  @@map("strategy_nodes")
  @@schema("strategy")
}

model StrategyEdge {
  id            String           @id @default(uuid()) @db.Uuid
  fromNodeId    String           @map("from_node_id") @db.Uuid
  toNodeId      String           @map("to_node_id") @db.Uuid
  edgeType      StrategyEdgeType @map("edge_type")
  planVersionId String           @map("plan_version_id") @db.Uuid
  fromNode      StrategyNode     @relation("StrategyEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  toNode        StrategyNode     @relation("StrategyEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  planVersion   PlanVersion      @relation(fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([fromNodeId, toNodeId, edgeType, planVersionId])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([planVersionId])
  @@map("strategy_edges")
  @@schema("strategy")
}

model RelationshipRule {
  id       String           @id @default(uuid()) @db.Uuid
  fromType StrategyNodeType @map("from_type")
  toType   StrategyNodeType @map("to_type")
  edgeType StrategyEdgeType @map("edge_type")
  minCount Int              @default(0) @map("min_count")
  maxCount Int?             @map("max_count")

  @@unique([fromType, toType, edgeType])
  @@map("relationship_rules")
  @@schema("strategy")
}

model OwnerAssignment {
  id          String       @id @default(uuid()) @db.Uuid
  nodeId      String       @map("node_id") @db.Uuid
  ownerUserId String       @map("owner_user_id")
  assignedBy  String       @map("assigned_by")
  assignedAt  DateTime     @default(now()) @map("assigned_at")
  node        StrategyNode @relation(fields: [nodeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  owner       User         @relation("StrategyOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assigner    User         @relation("StrategyAssigner", fields: [assignedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([nodeId, ownerUserId])
  @@index([ownerUserId])
  @@map("owner_assignments")
  @@schema("strategy")
}

model StagedChange {
  id             String             @id @default(uuid()) @db.Uuid
  approvalCaseId String             @map("approval_case_id") @db.Uuid
  planVersionId  String             @map("plan_version_id") @db.Uuid
  kind           StagedChangeKind
  targetId       String?            @map("target_id") @db.Uuid
  payload        Json
  status         StagedChangeStatus @default(PENDING)
  requestedBy    String             @map("requested_by")
  requestedAt    DateTime           @default(now()) @map("requested_at")
  appliedAt      DateTime?          @map("applied_at")
  planVersion    PlanVersion        @relation(fields: [planVersionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  requester      User               @relation("StrategyStagedChangeRequester", fields: [requestedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([approvalCaseId, status])
  @@index([planVersionId, status])
  @@map("staged_changes")
  @@schema("strategy")
}

// ---------------------------------------------------------------------------
// Strategy Hierarchy
//
// A separate, simpler tree of strategy nodes (plan/perspective/objective/
// initiative/project with a RAG status + progress %) that backs the
// "Strategy Hierarchy" page. Distinct from `strategy.StrategyNode` above,
// which models a different, bilingual, plan-versioned strategy *map* with
// its own graph-edge ontology — the two are intentionally not conflated.
// ---------------------------------------------------------------------------

enum StrategyHierarchyNodeType {
  PLAN        @map("plan")
  PERSPECTIVE @map("perspective")
  OBJECTIVE   @map("objective")
  INITIATIVE  @map("initiative")
  PROJECT     @map("project")

  @@schema("strategy_hierarchy")
}

enum StrategyHierarchyNodeStatus {
  ON_TRACK    @map("on-track")
  AT_RISK     @map("at-risk")
  OFF_TRACK   @map("off-track")
  NOT_STARTED @map("not-started")

  @@schema("strategy_hierarchy")
}

model StrategyHierarchyNode {
  id            String                      @id @default(uuid()) @db.Uuid
  parentId      String?                     @map("parent_id") @db.Uuid
  name          String
  type          StrategyHierarchyNodeType
  status        StrategyHierarchyNodeStatus @default(NOT_STARTED)
  progress      Int                         @default(0)
  ownerName     String                      @map("owner_name")
  ownerInitials String                      @map("owner_initials")
  ownerColor    String                      @map("owner_color")
  budget        String?
  startDate     DateTime?                   @map("start_date") @db.Date
  endDate       DateTime?                   @map("end_date") @db.Date
  description   String?                     @db.Text
  linkedKpis    String[]                    @default([]) @map("linked_kpis")
  createdBy     String                      @map("created_by")
  createdAt     DateTime                    @default(now()) @map("created_at")
  updatedAt     DateTime                    @updatedAt @map("updated_at")

  parent   StrategyHierarchyNode?      @relation("StrategyHierarchyNodeChildren", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  children StrategyHierarchyNode[]     @relation("StrategyHierarchyNodeChildren")
  creator  User                        @relation("StrategyHierarchyNodeCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  activity StrategyHierarchyActivity[]

  @@index([parentId])
  @@map("strategy_hierarchy_nodes")
  @@schema("strategy_hierarchy")
}

model StrategyHierarchyActivity {
  id        String                @id @default(uuid()) @db.Uuid
  nodeId    String                @map("node_id") @db.Uuid
  message   String
  actorName String                @map("actor_name")
  createdAt DateTime              @default(now()) @map("created_at")
  node      StrategyHierarchyNode @relation(fields: [nodeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([nodeId, createdAt])
  @@map("strategy_hierarchy_activity")
  @@schema("strategy_hierarchy")
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

enum PeriodType {
  MONTH
  QUARTER
  YEAR

  @@schema("scheduling")
}

enum CadenceType {
  MONTHLY
  QUARTERLY
  ADHOC

  @@schema("scheduling")
}

enum CadenceStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED

  @@schema("scheduling")
}

enum CatchUpPolicy {
  FIRE_ALL
  FIRE_LATEST_ONLY
  SKIP_MISSED

  @@schema("scheduling")
}

enum CadenceInstanceStatus {
  PENDING
  OPEN
  CLOSING
  CLOSED
  REVIEW_DUE
  COMPLETED
  SKIPPED
  FAILED

  @@schema("scheduling")
}

model PeriodCalendar {
  id                   String     @id @default(uuid())
  key                  String     @unique
  name                 String
  description          String?
  periodType           PeriodType @map("period_type")
  fiscalYearStartMonth Int        @default(1) @map("fiscal_year_start_month")
  timezone             String     @default("UTC")
  isActive             Boolean    @default(true) @map("is_active")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  cadenceDefinitions CadenceDefinition[]

  @@map("period_calendars")
  @@schema("scheduling")
}

model CadenceDefinition {
  id          String  @id @default(uuid())
  key         String
  name        String
  description String?

  subjectType String @map("subject_type")
  subjectId   String @map("subject_id")
  payload     Json   @default("{}")

  cadenceType   CadenceType @map("cadence_type")
  cadenceConfig Json        @map("cadence_config")

  periodCalendarId String?         @map("period_calendar_id")
  periodCalendar   PeriodCalendar? @relation(fields: [periodCalendarId], references: [id], onDelete: SetNull)

  timezone String    @default("UTC")
  anchorAt DateTime  @map("anchor_at")
  startsAt DateTime  @map("starts_at")
  endsAt   DateTime? @map("ends_at")

  status        CadenceStatus @default(ACTIVE)
  catchUpPolicy CatchUpPolicy @default(FIRE_LATEST_ONLY) @map("catch_up_policy")

  lookaheadSeconds Int @default(300) @map("lookahead_seconds")

  windowOpenOffsetMinutes Int @default(0) @map("window_open_offset_minutes")
  windowDurationMinutes   Int @default(1440) @map("window_duration_minutes")
  closingWarningMinutes   Int @default(60) @map("closing_warning_minutes")
  reviewDueOffsetMinutes  Int @default(0) @map("review_due_offset_minutes")

  nextOccurrenceAt   DateTime? @map("next_occurrence_at")
  lastMaterializedAt DateTime? @map("last_materialized_at")

  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  instances CadenceInstance[]

  @@unique([subjectType, subjectId, key])
  @@index([status, nextOccurrenceAt])
  @@index([periodCalendarId])
  @@map("cadence_definitions")
  @@schema("scheduling")
}

model CadenceInstance {
  id                  String            @id @default(uuid())
  cadenceDefinitionId String            @map("cadence_definition_id")
  cadenceDefinition   CadenceDefinition @relation(fields: [cadenceDefinitionId], references: [id], onDelete: Cascade)

  sequence     Int
  occurrenceAt DateTime @map("occurrence_at")

  periodKey      String?   @map("period_key")
  periodStartsAt DateTime? @map("period_starts_at")
  periodEndsAt   DateTime? @map("period_ends_at")

  windowOpensAt   DateTime @map("window_opens_at")
  windowClosingAt DateTime @map("window_closing_at")
  windowClosesAt  DateTime @map("window_closes_at")
  reviewDueAt     DateTime @map("review_due_at")

  status           CadenceInstanceStatus @default(PENDING)
  nextTransitionAt DateTime?             @map("next_transition_at")

  openedAt          DateTime? @map("opened_at")
  closingNotifiedAt DateTime? @map("closing_notified_at")
  closedAt          DateTime? @map("closed_at")
  reviewNotifiedAt  DateTime? @map("review_notified_at")

  payloadSnapshot Json    @map("payload_snapshot")
  skipReason      String? @map("skip_reason")
  attempts        Int     @default(0)
  lastError       String? @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cadenceDefinitionId, occurrenceAt])
  @@index([status, nextTransitionAt])
  @@map("cadence_instances")
  @@schema("scheduling")
}

