  ruleVersionUsed String   @map("rule_version_used")
  dedupeKey       String   @unique @map("dedupe_key")
  ruleVersion RuleDefinition @relation("StatusResultRuleVersion", fields: [ruleVersionUsed], references: [id], onDelete: Restrict)
  kpiVersion KpiVersion   @relation("PerformanceStatusKpiVersion", fields: [kpiVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scopeNode  StrategyNode @relation("PerformanceStatusScope", fields: [scopeNodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([kpiVersionId, scopeNodeId, period, computedAt])
  @@index([computedAt])
  @@index([ruleVersionUsed])
  @@map("status_results")
  @@schema("performance")
}

model RollupResult {
  id              String   @id @default(uuid())
  parentKpiId     String   @map("parent_kpi_id")
  scopeNodeId     String   @map("scope_node_id") @db.Uuid
  period          String
  aggregatedValue Decimal? @map("aggregated_value") @db.Decimal(20, 6)
  method          String
  computedAt      DateTime @default(now()) @map("computed_at")
  ruleVersionUsed String   @map("rule_version_used")
  dedupeKey       String   @unique @map("dedupe_key")
  ruleVersion RuleDefinition @relation("RollupResultRuleVersion", fields: [ruleVersionUsed], references: [id], onDelete: Restrict)
  parentKpi KpiDefinition @relation("PerformanceRollupParent", fields: [parentKpiId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scopeNode StrategyNode  @relation("PerformanceRollupScope", fields: [scopeNodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([parentKpiId, scopeNodeId, period, computedAt])
  @@index([computedAt])
  @@index([ruleVersionUsed])
  @@map("rollup_results")
  @@schema("performance")
}

model Commentary {
  id           String   @id @default(uuid())
  kpiVersionId String   @map("kpi_version_id")
  scopeNodeId  String   @map("scope_node_id") @db.Uuid
  period       String
  authorId     String   @map("author_id")
  bodyEn       String?  @map("body_en")
  bodyAr       String?  @map("body_ar")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  author User @relation("CommentaryAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  kpiVersion KpiVersion   @relation("PerformanceCommentaryKpiVersion", fields: [kpiVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scopeNode  StrategyNode @relation("PerformanceCommentaryScope", fields: [scopeNodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([kpiVersionId, scopeNodeId, period, createdAt])
  @@index([authorId])
  @@map("commentary")
  @@schema("performance")
}

model CaptureSession {
  id           String              @id @default(uuid())
  kpiVersionId String              @map("kpi_version_id")
  scopeNodeId  String              @map("scope_node_id") @db.Uuid
  period       String
  state        CaptureSessionState @default(DRAFT)
  ownerId      String              @map("owner_id")
  submittedMeasurementId String?   @map("submitted_measurement_id")
  submittedAt            DateTime? @map("submitted_at")
  recalledAt             DateTime? @map("recalled_at")
  recallDeadlineAt       DateTime? @map("recall_deadline_at")
  consumedAt             DateTime? @map("consumed_at")
  draftValue             Decimal?  @map("draft_value") @db.Decimal(30, 10)
  draftEvidenceRef       String?   @map("draft_evidence_ref")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  owner User @relation("CaptureSessionOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  kpiVersion KpiVersion   @relation("PerformanceCaptureKpiVersion", fields: [kpiVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scopeNode  StrategyNode @relation("PerformanceCaptureScope", fields: [scopeNodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([kpiVersionId, scopeNodeId, period, state])
  @@index([ownerId])
  @@index([state])
  @@map("capture_sessions")
  @@schema("performance")
}

// ---------------------------------------------------------------------------
// Scorecard (Phase 3.1)
// ---------------------------------------------------------------------------

enum ScorecardStrategyMapState {
  DRAFT     @map("draft")
  PUBLISHED @map("published")

  @@map("strategy_map_state")
  @@schema("scorecard")
}

enum ScorecardMapLinkStrength {
  WEAK   @map("weak")
  STRONG @map("strong")

  @@map("map_link_strength")
  @@schema("scorecard")
}

model Scorecard {
  id            String   @id @default(uuid()) @db.Uuid
  nameEn        String   @map("name_en")
  nameAr        String   @map("name_ar")
  scopeNodeId   String?  @map("scope_node_id") @db.Uuid
  planVersionId String   @map("plan_version_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([scopeNodeId])
  @@index([planVersionId])
  @@map("scorecards")
  @@schema("scorecard")
}

model Perspective {
  id          String   @id @default(uuid()) @db.Uuid
  scorecardId String   @map("scorecard_id") @db.Uuid
  nameEn      String   @map("name_en")
  nameAr      String   @map("name_ar")
  order       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([scorecardId, order])
  @@index([scorecardId])
  @@map("perspectives")
  @@schema("scorecard")
}

model Placement {
  id              String   @id @default(uuid()) @db.Uuid
  perspectiveId   String   @map("perspective_id") @db.Uuid
  objectiveNodeId String   @map("objective_node_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([perspectiveId, objectiveNodeId])
  @@index([objectiveNodeId])
  @@map("placements")
  @@schema("scorecard")
}

model WeightingVersion {
  id                 String   @id @default(uuid()) @db.Uuid
  scorecardId        String   @map("scorecard_id") @db.Uuid
  perspectiveWeights Json     @map("perspective_weights")
  scoringFormulaId   String   @map("scoring_formula_id")
  activeFrom         DateTime @map("active_from")
  supersedesId       String?  @unique @map("supersedes_id") @db.Uuid
  approvalCaseId     String?  @map("approval_case_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([scorecardId, activeFrom])
  @@index([scoringFormulaId])
  @@map("weighting_versions")
  @@schema("scorecard")
}

model StrategyMap {
  id             String                    @id @default(uuid()) @db.Uuid
  scorecardId    String                    @map("scorecard_id") @db.Uuid
  state          ScorecardStrategyMapState @default(DRAFT)
  approvalCaseId String?                   @map("approval_case_id") @db.Uuid
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  @@index([scorecardId, state])
  @@map("strategy_maps")
  @@schema("scorecard")
}

model MapLink {
  id              String                       @id @default(uuid()) @db.Uuid
  strategyMapId   String                       @map("strategy_map_id") @db.Uuid
  fromObjectiveId String                       @map("from_objective_id") @db.Uuid
  toObjectiveId   String                       @map("to_objective_id") @db.Uuid
  strength        ScorecardMapLinkStrength
  createdAt       DateTime                     @default(now()) @map("created_at")

  @@unique([strategyMapId, fromObjectiveId, toObjectiveId])
  @@index([fromObjectiveId])
  @@index([toObjectiveId])
  @@map("map_links")
  @@schema("scorecard")
}

// ---------------------------------------------------------------------------
// Execution (Phase 4.1)
//
// ADR-06 boundary: this schema is intentionally a thin strategy-to-delivery
// linkage layer. Do not add task lists, resource assignments, dependency graphs
// or Gantt scheduling here; detailed project management remains in Jira.
// ---------------------------------------------------------------------------

enum InitiativeStage {
  DESIGN  @map("design")
  PILOT   @map("pilot")
  EXECUTE @map("execute")
  SCALE   @map("scale")
  DONE    @map("done")
  @@schema("execution")
}

enum MilestoneHealth {
  ON_TIME @map("on_time")
  AT_RISK @map("at_risk")
  LATE    @map("late")
  @@schema("execution")
}

enum ExecutionSource {
  MANUAL @map("manual")
  JIRA   @map("jira")
  ERP    @map("erp")
  @@schema("execution")
}

enum InitiativeStatus {
  ON_TRACK  @map("on_track")
  AT_RISK   @map("at_risk")
  OFF_TRACK @map("off_track")
  @@schema("execution")
}

enum ConfidenceLevel {
  HIGH   @map("high")
  MEDIUM @map("medium")
  LOW    @map("low")
  @@schema("execution")
}

enum RiskLevel {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")
  @@schema("execution")
}

model Initiative {
  id                  String          @id @default(uuid()) @db.Uuid
  nameEn              String          @map("name_en")
  nameAr              String          @map("name_ar")
  strategicPlayNodeId String          @map("strategic_play_node_id") @db.Uuid
  ownerUserId         String          @map("owner_user_id")
  stage               InitiativeStage
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  @@index([strategicPlayNodeId])
  @@index([ownerUserId])
  @@map("initiatives")
  @@schema("execution")
}

model JiraLink {
  id             String    @id @default(uuid()) @db.Uuid
  initiativeId   String    @unique @map("initiative_id") @db.Uuid
  jiraProjectKey String    @map("jira_project_key")
  jiraProjectUrl String    @map("jira_project_url")
  lastSyncedAt   DateTime? @map("last_synced_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  @@map("jira_links")
  @@schema("execution")
}

model MilestoneFlag {
  id           String          @id @default(uuid()) @db.Uuid
  jiraLinkId   String          @map("jira_link_id") @db.Uuid
  nameEn       String          @map("name_en")
  nameAr       String          @map("name_ar")
  dueDate      DateTime        @map("due_date") @db.Date
  forecastDate DateTime?       @map("forecast_date") @db.Date
  health       MilestoneHealth
  source       ExecutionSource
  createdAt    DateTime        @default(now()) @map("created_at")
  @@index([jiraLinkId])
  @@map("milestone_flags")
  @@schema("execution")
}

model StatusUpdate {
  id           String           @id @default(uuid()) @db.Uuid
  initiativeId String           @map("initiative_id") @db.Uuid
  period       String
  stage        InitiativeStage
  status       InitiativeStatus
  confidence   ConfidenceLevel
  narrativeEn  String?          @map("narrative_en")
  narrativeAr  String?          @map("narrative_ar")
  submittedBy  String           @map("submitted_by")
  createdAt    DateTime         @default(now()) @map("created_at")
  @@index([initiativeId, period, createdAt])
  @@map("status_updates")
  @@schema("execution")
}

model FinancialAttr {
  id           String          @id @default(uuid()) @db.Uuid
  initiativeId String          @unique @map("initiative_id") @db.Uuid
  budgetAmount Decimal         @map("budget_amount") @db.Decimal(20, 6)
  spendAmount  Decimal         @map("spend_amount") @db.Decimal(20, 6)
  currency     String
  source       ExecutionSource
  locked       Boolean         @default(false)
  updatedAt    DateTime        @updatedAt @map("updated_at")
  @@map("financial_attrs")
  @@schema("execution")
}

model RiskIndicator {
  id           String          @id @default(uuid()) @db.Uuid
  initiativeId String          @unique @map("initiative_id") @db.Uuid
  level        RiskLevel
  source       ExecutionSource
  locked       Boolean         @default(false)
  updatedAt    DateTime        @updatedAt @map("updated_at")
  @@map("risk_indicators")
  @@schema("execution")
}

// ---------------------------------------------------------------------------
// Value Management (Phase 5.1)
// ---------------------------------------------------------------------------

enum ValueLifecycleState {
  IDENTIFICATION   @map("identification")
  PENDING_APPROVAL @map("pending_approval")
  APPROVED         @map("approved")
  VALIDATION       @map("validation")
  TRACKING         @map("tracking")
  CLOSURE          @map("closure")

  @@schema("value")
}

enum ValueEntryState {
  PLANNED  @map("planned")
  INFLIGHT @map("inflight")
  REALIZED @map("realized")

  @@schema("value")
}

enum ValueEntrySource {
  MANUAL @map("manual")
  FEED   @map("feed")

  @@schema("value")
}

enum GateDecision {
  CONTINUE  @map("continue")
  INTERVENE @map("intervene")
  STOP      @map("stop")

  @@schema("value")
}

model ValueCategory {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("value_categories")
  @@schema("value")
}

model Benefit {
  id               String              @id @default(uuid()) @db.Uuid
  initiativeId     String              @map("initiative_id") @db.Uuid
  categoryId       String              @map("category_id") @db.Uuid
  driver           String
  ownerUserId      String              @map("owner_user_id")
  workflowCaseId   String?             @map("workflow_case_id") @db.Uuid
  lifecycleState   ValueLifecycleState @default(IDENTIFICATION) @map("lifecycle_state")
  workflowSnapshot Json                @default("{}") @map("workflow_snapshot")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([initiativeId])
  @@index([ownerUserId])
  @@index([workflowCaseId])
  @@map("benefits")
  @@schema("value")
}

model BenefitBaseline {
  id         String   @id @default(uuid()) @db.Uuid
  benefitId  String   @unique @map("benefit_id") @db.Uuid
  amount     Decimal  @db.Decimal(20, 6)
  currency   String
  approvedAt DateTime @map("approved_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("benefit_baselines")
  @@schema("value")
}

model BenefitFeedBinding {
  benefitId  String   @id @map("benefit_id") @db.Uuid
  bindingRef String   @map("binding_ref")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("benefit_feed_bindings")
  @@schema("value")
}

model ValueStateEntry {
  id         String           @id @default(uuid()) @db.Uuid
  benefitId  String           @map("benefit_id") @db.Uuid
  state      ValueEntryState
  amount     Decimal          @db.Decimal(20, 6)
  currency   String
  period     String
  source     ValueEntrySource
  lineageRef String?          @map("lineage_ref")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([benefitId, state, period])
  @@map("value_state_entries")
  @@schema("value")
}

model Checkin {
  id                      String    @id @default(uuid()) @db.Uuid
  benefitId               String    @map("benefit_id") @db.Uuid
  dueAt                   DateTime  @map("due_at")
  completedAt             DateTime? @map("completed_at")
  monthsPostDelivery      Int       @map("months_post_delivery") @db.SmallInt
  realizedAmountAtCheckin Decimal?  @map("realized_amount_at_checkin") @db.Decimal(20, 6)
  escalationCaseId        String?   @map("escalation_case_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at")

  @@unique([benefitId, monthsPostDelivery])
  @@map("checkins")
  @@schema("value")
}

model GateReview {
  id                   String        @id @default(uuid()) @db.Uuid
  initiativeId         String        @map("initiative_id") @db.Uuid
  stage                String
  criteriaEvalSnapshot Json          @map("criteria_eval_snapshot")
  decision             GateDecision?
  decidedBy            String?       @map("decided_by")
  decidedAt            DateTime?     @map("decided_at")
  createdBy            String        @map("created_by")
  createdAt            DateTime      @default(now()) @map("created_at")

  @@index([initiativeId, stage, createdAt])
  @@map("gate_reviews")
  @@schema("value")
}
